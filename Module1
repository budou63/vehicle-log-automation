Private Function 入力内容チェック実行(ByVal 結果表示 As Boolean) As Long
    Dim ws As Worksheet, lastRow As Long, rowNo As Long, gasolineColumn As Long
    Dim startMeterColumn As Long, endMeterColumn As Long, startTimeColumn As Long, endTimeColumn As Long
    Dim startMeter As Double, endMeter As Double, distanceKm As Double
    Dim startTime As Double, endTime As Double, durationMinutes As Long
    Dim startTimeValid As Boolean, endTimeValid As Boolean
    Dim warningText As String, commentFailures As Long

    Set ws = ThisWorkbook.Sheets("記録")
    Set vehicleReviewCandidates = New Collection
    lastRow = 記録最終行(ws)
    If lastRow < 2 Then
        If 結果表示 Then MsgBox "確認対象の記録がありません。", vbInformation
        Exit Function
    End If

    startMeterColumn = 記録列番号(ws, "始業時メーター(km)")
    endMeterColumn = 記録列番号(ws, "終業時メーター(km)")
    startTimeColumn = 記録列番号(ws, "使用時間（始）")
    endTimeColumn = 記録列番号(ws, "使用時間（終）")
    gasolineColumn = ガソリン給油列を取得(ws)
    If startMeterColumn = 0 Or endMeterColumn = 0 Or startTimeColumn = 0 Or endTimeColumn = 0 Then
        MsgBox "記録シートのメーターまたは使用時間の見出しが見つかりません。", vbExclamation
        入力内容チェック実行 = 1
        Exit Function
    End If

    Call 前回の自動チェック警告を除去(ws, 2, lastRow, commentFailures, gasolineColumn)
    For rowNo = 2 To lastRow
        If Not 記録行は確認済み(ws, rowNo) Then
            If 数値入力あり(ws.Cells(rowNo, startMeterColumn).Value) And _
               数値入力あり(ws.Cells(rowNo, endMeterColumn).Value) Then
                startMeter = CDbl(ws.Cells(rowNo, startMeterColumn).Value)
                endMeter = CDbl(ws.Cells(rowNo, endMeterColumn).Value)
                distanceKm = endMeter - startMeter
                If distanceKm < 0 Then
                    warningText = "要確認：終業時メーターが始業時メーターより小さくなっています。" & vbCrLf & _
                                  "始業時メーター：" & Format$(startMeter, "0.##") & "km" & vbCrLf & _
                                  "終業時メーター：" & Format$(endMeter, "0.##") & "km" & vbCrLf & "入力内容を確認してください。"
                    Call 自動チェック警告を追加(ws.Cells(rowNo, startMeterColumn), warningText, commentFailures)
                    Call 自動チェック警告を追加(ws.Cells(rowNo, endMeterColumn), warningText, commentFailures)
                ElseIf distanceKm >= CHECK_LONG_DISTANCE_KM Then
                    warningText = "要確認：1回の走行距離が" & Format$(CHECK_LONG_DISTANCE_KM, "0.##") & "km以上です。" & vbCrLf & _
                                  "始業時メーター：" & Format$(startMeter, "0.##") & "km" & vbCrLf & _
                                  "終業時メーター：" & Format$(endMeter, "0.##") & "km" & vbCrLf & _
                                  "走行距離：" & Format$(distanceKm, "0.##") & "km" & vbCrLf & "入力内容を確認してください。"
                    Call 自動チェック警告を追加(ws.Cells(rowNo, startMeterColumn), warningText, commentFailures)
                    Call 自動チェック警告を追加(ws.Cells(rowNo, endMeterColumn), warningText, commentFailures)
                End If
            End If

            startTimeValid = 時刻を取得(ws.Cells(rowNo, startTimeColumn).Value, startTime)
            endTimeValid = 時刻を取得(ws.Cells(rowNo, endTimeColumn).Value, endTime)
            If セルに値がある(ws.Cells(rowNo, startTimeColumn).Value) And Not startTimeValid Then
                warningText = "要確認：使用開始時刻を時刻として認識できません。入力値：" & _
                              セル値を表示(ws.Cells(rowNo, startTimeColumn).Value) & "。入力内容を確認してください。"
                Call 自動チェック警告を追加(ws.Cells(rowNo, startTimeColumn), warningText, commentFailures)
            End If
            If セルに値がある(ws.Cells(rowNo, endTimeColumn).Value) And Not endTimeValid Then
                warningText = "要確認：使用終了時刻を時刻として認識できません。入力値：" & _
                              セル値を表示(ws.Cells(rowNo, endTimeColumn).Value) & "。入力内容を確認してください。"
                Call 自動チェック警告を追加(ws.Cells(rowNo, endTimeColumn), warningText, commentFailures)
            End If

            If startTimeValid And endTimeValid Then
                If endTime < startTime Then
                    warningText = "要確認：使用終了時刻が開始時刻より前になっています。" & vbCrLf & _
                                  "開始：" & Format$(startTime, "hh:mm") & vbCrLf & _
                                  "終了：" & Format$(endTime, "hh:mm") & vbCrLf & "入力内容を確認してください。"
                    Call 自動チェック警告を追加(ws.Cells(rowNo, startTimeColumn), warningText, commentFailures)
                    Call 自動チェック警告を追加(ws.Cells(rowNo, endTimeColumn), warningText, commentFailures)
                Else
                    durationMinutes = CLng((endTime - startTime) * 1440# + 0.5)
                    If (endTime - startTime) * 24# >= CHECK_LONG_USAGE_HOURS Then
                        warningText = "要確認：使用時間が" & Format$(CHECK_LONG_USAGE_HOURS, "0.##") & "時間以上です。" & vbCrLf & _
                                      "開始：" & Format$(startTime, "hh:mm") & vbCrLf & "終了：" & Format$(endTime, "hh:mm") & vbCrLf & _
                                      "使用時間：" & 使用時間を表示(durationMinutes) & vbCrLf & "入力内容を確認してください。"
                        Call 自動チェック警告を追加(ws.Cells(rowNo, startTimeColumn), warningText, commentFailures)
                        Call 自動チェック警告を追加(ws.Cells(rowNo, endTimeColumn), warningText, commentFailures)
                    End If
                End If
            End If

            If gasolineColumn > 0 Then
                Call ガソリン給油量をチェック(ws.Cells(rowNo, gasolineColumn), commentFailures)
            End If
        End If
    Next rowNo

    Call 車両選択候補をチェック(ws, lastRow, commentFailures)
    入力内容チェック実行 = commentFailures
    If commentFailures > 0 Then
        MsgBox "入力チェックは完了しましたが、" & commentFailures & _
               "セルの警告コメントまたは既存コメントを処理できませんでした。該当セルを確認してください。", vbExclamation
    ElseIf 結果表示 Then
        MsgBox "入力内容チェックが完了しました。要確認の記録には赤字・太字とコメントを付けています。", vbInformation
    End If
End Function

