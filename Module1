Public Sub 車両候補の対象行へ移動(ByVal answerNumber As String)
    Dim ws As Worksheet, foundRow As Long, vehicleColumn As Long
    Set ws = ThisWorkbook.Sheets("記録")
    foundRow = 回答番号行を検索(ws, answerNumber)
    vehicleColumn = 記録列番号(ws, "車両番号")
    If foundRow > 0 And vehicleColumn > 0 Then
        If 記録行は確認済み(ws, foundRow) Then
            MsgBox "この記録は確認済みです。修正する場合は先にチェックを外してください。", vbExclamation
            Exit Sub
        End If
        ws.Activate
        ws.Cells(foundRow, vehicleColumn).Select
    Else
        MsgBox "回答番号 " & answerNumber & " を一意に特定できません。再チェックしてください。", vbExclamation
    End If
