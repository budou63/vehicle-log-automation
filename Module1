Public Function 車両候補を承認して修正(ByVal answerNumber As String, ByVal expectedVehicle As String, _
                                      ByVal expectedCandidate As String) As Boolean
    Dim ws As Worksheet, foundRow As Long, vehicleColumn As Long
    Dim item As Object, currentCandidate As Object
    Set ws = ThisWorkbook.Sheets("記録")
    foundRow = 回答番号行を検索(ws, answerNumber)
    If foundRow = 0 Then
        MsgBox "回答番号を一意に特定できないため修正しませんでした。", vbExclamation
        Exit Function
    End If
    If 記録行は確認済み(ws, foundRow) Then
        MsgBox "この記録は確認済みです。修正する場合は先にチェックを外してください。", vbExclamation
        Exit Function
    End If

    Call 最新の車両候補を再判定
    For Each item In vehicleReviewCandidates
        If CStr(item("回答番号")) = answerNumber And CStr(item("登録車両")) = expectedVehicle And _
           CStr(item("候補車両")) = expectedCandidate Then Set currentCandidate = item: Exit For
    Next item
    If currentCandidate Is Nothing Then
        MsgBox "対象記録の条件が変わったため修正しませんでした。内容チェックをやり直してください。", vbExclamation
        Exit Function
    End If

    vehicleColumn = 記録列番号(ws, "車両番号")
    If vehicleColumn = 0 Then
        MsgBox "車両番号の見出しが見つからないため修正しませんでした。", vbExclamation
        Exit Function
    End If
    If Trim$(CStr(ws.Cells(foundRow, vehicleColumn).Value)) <> expectedVehicle Then
        MsgBox "回答番号または現在の車両番号を一意に確認できないため修正しませんでした。", vbExclamation
        Exit Function
    End If
    ws.Cells(foundRow, vehicleColumn).Value = expectedCandidate
    vehicleReviewHasChanges = True
    車両候補を承認して修正 = True
End Function

Public Sub 車両候補確認を終了()
    Dim ws As Worksheet, validationFailures As Long, driverFailures As Long
    Dim fuelSucceeded As Boolean, confirmedCount As Long, reviewCount As Long
    Dim autoConfirmAllowed As Boolean

    vehicleReviewIsOpen = False
    If vehicleReviewHasChanges Then
        vehicleReviewHasChanges = False
        Set ws = ThisWorkbook.Sheets("記録")
        validationFailures = 記録シート整理を実行(False)
        driverFailures = 運転者氏名をチェック()
        fuelSucceeded = 給油記録を照合実行(False)
        autoConfirmAllowed = (validationFailures = 0 And driverFailures = 0 And fuelSucceeded)
        Call 未確認行を自動確定(ws, confirmedCount, reviewCount, autoConfirmAllowed)
        MsgBox "車両候補の確認後チェックが完了しました。" & vbCrLf & _
               "自動で確認済み：" & confirmedCount & "件" & vbCrLf & _
               "要確認・未確定：" & reviewCount & "件", vbInformation
    End If
End Sub

Private Sub 車両選択候補の事前チェック(ByVal ws As Worksheet, ByVal lastRow As Long)
    Dim rowNo As Long, commentFailures As Long, vehicleColumn As Long
    vehicleColumn = 記録列番号(ws, "車両番号")
    If vehicleColumn = 0 Then
        MsgBox "車両番号の見出しが見つかりません。車両候補を判定できません。", vbExclamation
        Exit Sub
    End If
    For rowNo = 2 To lastRow
        If Not 記録行は確認済み(ws, rowNo) Then
            Call セルの自動チェック警告を除去(ws.Cells(rowNo, vehicleColumn), commentFailures)
        End If
    Next rowNo
    Call 車両選択候補をチェック(ws, lastRow, commentFailures)
    If commentFailures > 0 Then
        MsgBox "車両選択候補の事前チェックで、" & commentFailures & _
               "セルの警告コメントまたは既存コメントを処理できませんでした。該当セルを確認してください。", vbExclamation
    End If
End Sub

