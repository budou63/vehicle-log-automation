Sub CSV取込()
    Dim ws As Worksheet, historyWS As Worksheet
    Set ws = ThisWorkbook.Sheets("記録")

    Dim filePath As String
    filePath = Application.GetOpenFilename("CSVファイル (*.csv), *.csv", , "CSVファイルを選択してください")
    If filePath = "False" Then Exit Sub

    Dim csvWB As Workbook
    Set csvWB = Workbooks.Open(filePath)
    Dim csvWS As Worksheet
    Set csvWS = csvWB.Sheets(1)

    Dim lastRowCSV As Long
    lastRowCSV = csvWS.Cells(csvWS.Rows.Count, 1).End(xlUp).Row
    If lastRowCSV < 3 Then
        MsgBox "CSVに有効なデータがありません。", vbExclamation
        csvWB.Close False
        Exit Sub
    End If

    On Error Resume Next
    Set historyWS = ThisWorkbook.Worksheets("取込履歴")
    On Error GoTo 0
    If historyWS Is Nothing Then
        MsgBox "「取込履歴」シートが見つかりません。CSV取込を中止します。", vbExclamation
        csvWB.Close False
        Exit Sub
    End If

    Dim historyIDs As Object
    Set historyIDs = CreateObject("Scripting.Dictionary")
    historyIDs.CompareMode = vbBinaryCompare
    If Not 取込履歴を準備(ws, historyWS, historyIDs) Then
        csvWB.Close False
        Exit Sub
    End If

    Dim i As Long, targetRow As Long
    Dim id As Variant, idKey As String
    Dim insertedCount As Long, historyFailureCount As Long
    Dim firstInsertedRow As Long, lastInsertedRow As Long

    For i = 3 To lastRowCSV
        id = csvWS.Cells(i, 1).Value
        idKey = 回答番号をキー化(id)
        If Len(idKey) > 0 Then
            If Not historyIDs.Exists(idKey) Then
                targetRow = 記録最終行(ws) + 1
                If targetRow < 2 Then targetRow = 2
                If Not CSV行を記録へ追加(csvWS, i, ws, targetRow) Then
                    MsgBox "CSV見出しを記録シートの列へ対応付けできないため、取込を中止しました。", vbExclamation
                    csvWB.Close False
                    Exit Sub
                End If
                insertedCount = insertedCount + 1
                If firstInsertedRow = 0 Then firstInsertedRow = targetRow
                lastInsertedRow = targetRow
                If Not 取込履歴へ追加(historyWS, historyIDs, id, idKey) Then
                    historyFailureCount = historyFailureCount + 1
                End If
            End If
        End If
    Next i

    csvWB.Close False

    If insertedCount > 0 Then
        Dim lastRow As Long: lastRow = lastInsertedRow
        Dim keyPairs As Variant
        keyPairs = Array( _
            Array("行先", "行先（その他）"), _
            Array("用務", "用務（その他）"), _
            Array("ガソリン給油の有無 [給油の場合はその他に数値入力（?）]", "ガソリン給油量"), _
            Array("軽油給油の有無 [給油の場合はその他に数値入力（?）]", "軽油給油量"), _
            Array("オイル給油の有無 [給油の場合はその他に数値入力（?）]", "オイル給油量") _
        )
        Dim mainCol As Long, subCol As Long, k As Long
        For k = LBound(keyPairs) To UBound(keyPairs)
            mainCol = 記録列番号(ws, CStr(keyPairs(k)(0)))
            subCol = 記録列番号(ws, CStr(keyPairs(k)(1)))
            If mainCol = 0 Or subCol = 0 Then
                MsgBox "列が見つかりません：" & vbCrLf & _
                       "主項目: " & keyPairs(k)(0) & vbCrLf & _
                       "補足項目: " & keyPairs(k)(1), vbExclamation
            Else
                For i = firstInsertedRow To lastRow
                    If Trim(ws.Cells(i, mainCol).Value) = "その他" Then
                        ws.Cells(i, mainCol).Value = ws.Cells(i, subCol).Value
                        ws.Cells(i, subCol).ClearContents
                    End If
                Next i
            End If
        Next k

        Dim deleteOnlyPairs As Variant
        deleteOnlyPairs = Array( _
            Array("確認者（運転前） [「運行管理者」＝主管課長]", "確認者運転前（その他）"), _
            Array("確認者（運転後） [「運行管理者」＝主管課長]", "確認者運転後（その他）") _
        )
        For k = LBound(deleteOnlyPairs) To UBound(deleteOnlyPairs)
            mainCol = 記録列番号(ws, CStr(deleteOnlyPairs(k)(0)))
            subCol = 記録列番号(ws, CStr(deleteOnlyPairs(k)(1)))
            If mainCol = 0 Or subCol = 0 Then
                MsgBox "列が見つかりません（削除対象）：" & vbCrLf & _
                       "主項目: " & deleteOnlyPairs(k)(0) & vbCrLf & _
                       "補足項目: " & deleteOnlyPairs(k)(1), vbExclamation
            Else
                For i = firstInsertedRow To lastRow
                    If Trim(ws.Cells(i, mainCol).Value) = "その他" Then
                        ws.Cells(i, mainCol).ClearContents
                    End If
                Next i
            End If
        Next k
    End If

    Call 入力内容チェック実行(False)
    If historyFailureCount > 0 Then
        MsgBox insertedCount & " 件のデータを追記しましたが、" & historyFailureCount & _
               " 件の回答番号を取込履歴へ登録できませんでした。履歴を確認してください。", vbExclamation
    Else
        MsgBox insertedCount & " 件のデータを追記し、「その他」の補完・削除処理を完了しました。", vbInformation
    End If
End Sub


Private Function 回答番号をキー化(ByVal answerId As Variant) As String
    On Error GoTo InvalidAnswerId
    If IsError(answerId) Or IsEmpty(answerId) Then Exit Function
    回答番号をキー化 = Trim$(CStr(answerId))
    Exit Function
InvalidAnswerId:
    回答番号をキー化 = ""
End Function

Private Function CSV行を記録へ追加(ByVal csvWS As Worksheet, ByVal sourceRow As Long, _
                                  ByVal recordWS As Worksheet, ByVal targetRow As Long) As Boolean
    Dim sourceHeaderRow As Long, sourceLastColumn As Long, dataLastColumn As Long, sourceColumn As Long
    Dim answerColumn As Long, checkColumn As Long, targetColumn As Long, sourceAnswerColumn As Long
    Dim headerValue As Variant, sourceAnswer As Variant, recordAnswer As Variant
    Dim targetColumns() As Long, mappedTargets As Object
    Dim lastRecordColumn As Long, existingLastRow As Long, appendRowSafe As Boolean

    On Error GoTo CopyFailed
    sourceHeaderRow = 2
    answerColumn = 記録列番号(recordWS, "回答番号")
    checkColumn = 記録列番号(recordWS, "チェック")
    If answerColumn = 0 Or checkColumn = 0 Then Exit Function
    existingLastRow = 記録最終行(recordWS)
    If targetRow <= existingLastRow Then Exit Function
    appendRowSafe = True
    If recordWS.Cells(targetRow, checkColumn).HasFormula Or _
       セルに値がある(recordWS.Cells(targetRow, checkColumn).Value) Then Exit Function

    sourceLastColumn = csvWS.Cells(sourceHeaderRow, csvWS.Columns.Count).End(xlToLeft).Column
    dataLastColumn = csvWS.Cells(sourceRow, csvWS.Columns.Count).End(xlToLeft).Column
    If dataLastColumn > sourceLastColumn Then sourceLastColumn = dataLastColumn
    ReDim targetColumns(1 To sourceLastColumn)
    Set mappedTargets = CreateObject("Scripting.Dictionary")

    For sourceColumn = 1 To sourceLastColumn
        headerValue = csvWS.Cells(sourceHeaderRow, sourceColumn).Value
        If IsError(headerValue) Then Exit Function
        If IsEmpty(headerValue) Or Len(Trim$(CStr(headerValue))) = 0 Then
            If セルに値がある(csvWS.Cells(sourceRow, sourceColumn).Value) Then Exit Function
        Else
            targetColumn = 記録列番号(recordWS, Trim$(CStr(headerValue)))
            If targetColumn = 0 Or targetColumn = checkColumn Then Exit Function
            If mappedTargets.Exists(CStr(targetColumn)) Then Exit Function
            mappedTargets.Add CStr(targetColumn), True
            targetColumns(sourceColumn) = targetColumn
            If targetColumn = answerColumn Then sourceAnswerColumn = sourceColumn
        End If
    Next sourceColumn
    If sourceAnswerColumn <> 1 Then Exit Function

    sourceAnswer = csvWS.Cells(sourceRow, sourceAnswerColumn).Value
    For sourceColumn = 1 To sourceLastColumn
        targetColumn = targetColumns(sourceColumn)
        If targetColumn > 0 Then
            recordWS.Cells(targetRow, targetColumn).Value = csvWS.Cells(sourceRow, sourceColumn).Value
        End If
    Next sourceColumn
    recordAnswer = recordWS.Cells(targetRow, answerColumn).Value
    If 回答番号をキー化(sourceAnswer) = "" Or _
       回答番号をキー化(recordAnswer) <> 回答番号をキー化(sourceAnswer) Then GoTo CopyFailed

    CSV行を記録へ追加 = True
    Exit Function
CopyFailed:
    lastRecordColumn = 記録最終列(recordWS)
    If appendRowSafe And lastRecordColumn >= 2 Then
        recordWS.Range(recordWS.Cells(targetRow, 2), recordWS.Cells(targetRow, lastRecordColumn)).ClearContents
    End If
    Err.Clear
End Function

Private Function 回答番号行を検索(ByVal ws As Worksheet, ByVal answerNumber As String) As Long
    Dim answerColumn As Long, lastRow As Long, rowNo As Long, matches As Long, foundRow As Long
    answerColumn = 記録列番号(ws, "回答番号")
    If answerColumn = 0 Then Exit Function
    lastRow = 記録最終行(ws)
    For rowNo = 2 To lastRow
        If 回答番号をキー化(ws.Cells(rowNo, answerColumn).Value) = answerNumber Then
            matches = matches + 1
            foundRow = rowNo
        End If
    Next rowNo
    If matches = 1 Then 回答番号行を検索 = foundRow
End Function

Private Function 取込履歴を準備(ByVal recordWS As Worksheet, ByVal historyWS As Worksheet, _
                              ByVal historyIDs As Object) As Boolean
    Dim headerValue As Variant, answerId As Variant, answerKey As String
    Dim lastHistoryRow As Long, lastRecordRow As Long, rowNo As Long, answerColumn As Long
    On Error GoTo PrepareFailed
    answerColumn = 記録列番号(recordWS, "回答番号")
    If answerColumn = 0 Then GoTo InvalidHeader
    headerValue = historyWS.Cells(1, 1).Value
    If IsError(headerValue) Then GoTo InvalidHeader
    If Len(Trim$(CStr(headerValue))) = 0 Then
        historyWS.Cells(1, 1).Value = "回答番号"
    ElseIf Trim$(CStr(headerValue)) <> "回答番号" Then
        GoTo InvalidHeader
    End If

    lastHistoryRow = historyWS.Cells(historyWS.Rows.Count, 1).End(xlUp).Row
    For rowNo = 2 To lastHistoryRow
        answerKey = 回答番号をキー化(historyWS.Cells(rowNo, 1).Value)
        If Len(answerKey) > 0 Then
            If Not historyIDs.Exists(answerKey) Then historyIDs.Add answerKey, True
        End If
    Next rowNo

    lastRecordRow = 記録最終行(recordWS)
    For rowNo = 2 To lastRecordRow
        answerId = recordWS.Cells(rowNo, answerColumn).Value
        answerKey = 回答番号をキー化(answerId)
        If Len(answerKey) > 0 Then
            If Not historyIDs.Exists(answerKey) Then
                If Not 取込履歴へ追加(historyWS, historyIDs, answerId, answerKey) Then GoTo PrepareFailed
            End If
        End If
    Next rowNo

    取込履歴を準備 = True
    Exit Function
InvalidHeader:
    MsgBox "「取込履歴」シートのA1を「回答番号」にしてください。データ保護のためCSV取込を中止しました。", vbExclamation
    Exit Function
PrepareFailed:
    MsgBox "取込履歴を同期できなかったため、CSV取込を中止しました。" & vbCrLf & Err.Description, vbExclamation
    Err.Clear
End Function


Private Function 取込履歴へ追加(ByVal historyWS As Worksheet, ByVal historyIDs As Object, _
                              ByVal answerId As Variant, ByVal answerKey As String) As Boolean
    Dim targetRow As Long
    On Error GoTo AddFailed
    If historyIDs.Exists(answerKey) Then
        取込履歴へ追加 = True
        Exit Function
    End If

    historyIDs.Add answerKey, True
    targetRow = historyWS.Cells(historyWS.Rows.Count, 1).End(xlUp).Row + 1
    If targetRow < 2 Then targetRow = 2
    historyWS.Cells(targetRow, 1).Value = answerId
    取込履歴へ追加 = True
    Exit Function
AddFailed:
    Err.Clear
End Function
Public Sub 運転者名マスタを初期作成()
    Dim ws As Worksheet, masterWS As Worksheet, lastRow As Long, rowNo As Long, outputRow As Long
    Dim rawValue As Variant, driverName As String, names As Object, existingA As Long, existingB As Long
    Dim driverColumn As Long

    On Error GoTo Failed
    Set ws = ThisWorkbook.Worksheets("記録")
    driverColumn = 記録列番号(ws, "運転者氏名")
    If driverColumn = 0 Then
        MsgBox "記録シートの「運転者氏名」見出しが見つかりません。", vbExclamation
        Exit Sub
    End If
    On Error Resume Next
    Set masterWS = ThisWorkbook.Worksheets("運転者名マスタ")
    On Error GoTo Failed
    If masterWS Is Nothing Then
        Set masterWS = ThisWorkbook.Worksheets.Add(After:=ThisWorkbook.Worksheets(ThisWorkbook.Worksheets.Count))
        masterWS.Name = "運転者名マスタ"
    Else
        existingA = masterWS.Cells(masterWS.Rows.Count, "A").End(xlUp).Row
        existingB = masterWS.Cells(masterWS.Rows.Count, "B").End(xlUp).Row
        If existingA > 1 Or (Len(Trim$(CStr(masterWS.Cells(1, "A").Value))) > 0 And _
                              CStr(masterWS.Cells(1, "A").Value) <> "正式な運転者氏名") Then
            MsgBox "運転者名マスタのA列に既存データがあるため、上書きしませんでした。", vbExclamation
            Exit Sub
        End If
        If existingB > 1 Or (Len(Trim$(CStr(masterWS.Cells(1, "B").Value))) > 0 And _
                              CStr(masterWS.Cells(1, "B").Value) <> "メモ") Then
            MsgBox "運転者名マスタのB列に既存データがあるため、上書きしませんでした。", vbExclamation
            Exit Sub
        End If
    End If

    masterWS.Cells(1, "A").Value = "正式な運転者氏名"
    masterWS.Cells(1, "B").Value = "メモ"
    Set names = CreateObject("Scripting.Dictionary")
    names.CompareMode = vbBinaryCompare
    lastRow = 記録最終行(ws)
    outputRow = 2
    For rowNo = 2 To lastRow
        rawValue = ws.Cells(rowNo, driverColumn).Value
        If Not IsError(rawValue) And Not IsEmpty(rawValue) Then
            driverName = 運転者名の前後空白を除去(CStr(rawValue))
            If Len(driverName) > 0 Then
                If Not names.Exists(driverName) Then
                    names.Add driverName, True
                    masterWS.Cells(outputRow, "A").Value = driverName
                    masterWS.Cells(outputRow, "B").Value = "初期抽出・要確認"
                    outputRow = outputRow + 1
                End If
            End If
        End If
    Next rowNo
    MsgBox "運転者名マスタを作成しました。" & CStr(outputRow - 2) & "件を抽出しました。内容を確認してください。", vbInformation
    Exit Sub
Failed:
    MsgBox "運転者名マスタを作成できませんでした。" & Err.Description, vbExclamation
    Err.Clear
End Sub

Private Function 運転者氏名をチェック() As Long
    Dim ws As Worksheet, masterWS As Worksheet, masterNames As Collection
    Dim exactCounts As Object, normalizedCounts As Object, variantsByName As Object, nameVariants As Object
    Dim lastRow As Long, lastNameRow As Long, rowNo As Long, errorCount As Long, driverColumn As Long
    Dim rawValue As Variant, driverName As String, compactName As String, warning As Variant
    Dim driverWarnings As Collection

    On Error GoTo Failed
    Set ws = ThisWorkbook.Worksheets("記録")
    driverColumn = 記録列番号(ws, "運転者氏名")
    If driverColumn = 0 Then Err.Raise vbObjectError + 129, "運転者氏名をチェック", "運転者氏名の見出しがありません。"
    lastRow = 記録最終行(ws)
    For rowNo = 2 To lastRow
        If Not 記録行は確認済み(ws, rowNo) Then
            Call セルの自動チェック警告カテゴリを除去(ws.Cells(rowNo, driverColumn), errorCount, "運転者名警告")
        End If
    Next rowNo

    Set exactCounts = CreateObject("Scripting.Dictionary")
    exactCounts.CompareMode = vbBinaryCompare
    Set normalizedCounts = CreateObject("Scripting.Dictionary")
    normalizedCounts.CompareMode = vbBinaryCompare
    Set variantsByName = CreateObject("Scripting.Dictionary")
    variantsByName.CompareMode = vbBinaryCompare

    For rowNo = 2 To lastRow
        rawValue = ws.Cells(rowNo, driverColumn).Value
        If Not IsError(rawValue) And Not IsEmpty(rawValue) Then
            driverName = CStr(rawValue)
            compactName = 運転者名の空白を除去(driverName)
            If Len(compactName) > 0 Then
                If exactCounts.Exists(driverName) Then
                    exactCounts(driverName) = CLng(exactCounts(driverName)) + 1
                Else
                    exactCounts.Add driverName, 1
                End If
                If normalizedCounts.Exists(compactName) Then
                    normalizedCounts(compactName) = CLng(normalizedCounts(compactName)) + 1
                Else
                    normalizedCounts.Add compactName, 1
                End If
                If variantsByName.Exists(compactName) Then
                    Set nameVariants = variantsByName(compactName)
                Else
                    Set nameVariants = CreateObject("Scripting.Dictionary")
                    nameVariants.CompareMode = vbBinaryCompare
                    variantsByName.Add compactName, nameVariants
                End If
                If nameVariants.Exists(driverName) Then
                    nameVariants(driverName) = CLng(nameVariants(driverName)) + 1
                Else
                    nameVariants.Add driverName, 1
                End If
            End If
        End If
    Next rowNo

    Set masterNames = New Collection
    On Error Resume Next
    Set masterWS = ThisWorkbook.Worksheets("運転者名マスタ")
    On Error GoTo Failed
    If Not masterWS Is Nothing Then
        lastNameRow = masterWS.Cells(masterWS.Rows.Count, "A").End(xlUp).Row
        For rowNo = 2 To lastNameRow
            rawValue = masterWS.Cells(rowNo, "A").Value
            If Not IsError(rawValue) And Not IsEmpty(rawValue) Then
                driverName = 運転者名の前後空白を除去(CStr(rawValue))
                If Len(driverName) > 0 Then masterNames.Add driverName
            End If
        Next rowNo
    End If

    For rowNo = 2 To lastRow
        If Not 記録行は確認済み(ws, rowNo) Then
            rawValue = ws.Cells(rowNo, driverColumn).Value
            If IsError(rawValue) Then
                Call 自動チェック警告を追加(ws.Cells(rowNo, driverColumn), "要確認：運転者氏名を読み取れません。入力値を確認してください。", errorCount, "運転者名警告")
            ElseIf Not IsEmpty(rawValue) Then
                driverName = CStr(rawValue)
                If Len(運転者名の前後空白を除去(driverName)) > 0 Then
                    Set driverWarnings = 運転者名警告一覧(driverName, masterNames, exactCounts, normalizedCounts, variantsByName)
                    For Each warning In driverWarnings
                        Call 自動チェック警告を追加(ws.Cells(rowNo, driverColumn), CStr(warning), errorCount, "運転者名警告")
                    Next warning
                End If
            End If
        End If
    Next rowNo
    If errorCount > 0 Then MsgBox "運転者名警告の" & errorCount & "セルでコメントまたは書式を処理できませんでした。確認してください。", vbExclamation
    運転者氏名をチェック = errorCount
    Exit Function
Failed:
    MsgBox "運転者氏名チェックを中止しました。" & Err.Description, vbExclamation
    運転者氏名をチェック = errorCount + 1
    Err.Clear
End Function

Private Function 運転者名警告一覧(ByVal enteredName As String, ByVal masterNames As Collection, _
                                    ByVal exactCounts As Object, ByVal normalizedCounts As Object, _
                                    ByVal variantsByName As Object) As Collection
    Dim warnings As New Collection, trimmedName As String, compactName As String
    Dim masterName As Variant, otherName As Variant, otherCompact As Variant
    Dim masterTrimmed As String, compactMaster As String, characterValue As String
    Dim spacingMatches As Object, masterNearMatches As Object, historyNearMatches As Object
    Dim nameVariants As Object, currentCount As Long, i As Long, exactMasterMatch As Boolean
    Dim hasHalfSpace As Boolean, hasFullSpace As Boolean, invalidCharacters As String

    trimmedName = 運転者名の前後空白を除去(enteredName)
    compactName = 運転者名の空白を除去(trimmedName)
    If enteredName <> trimmedName Then warnings.Add "要確認：運転者氏名の前後に空白があります。"
    hasHalfSpace = (InStr(1, enteredName, " ", vbBinaryCompare) > 0)
    hasFullSpace = (InStr(1, enteredName, "　", vbBinaryCompare) > 0)
    If (hasHalfSpace And hasFullSpace) Or InStr(1, enteredName, "  ", vbBinaryCompare) > 0 Or _
       InStr(1, enteredName, "　　", vbBinaryCompare) > 0 Or InStr(1, enteredName, " 　", vbBinaryCompare) > 0 Or _
       InStr(1, enteredName, "　 ", vbBinaryCompare) > 0 Then
        warnings.Add "要確認：運転者氏名の空白表記を確認してください。"
    End If
    invalidCharacters = "0123456789０１２３４５６７８９?？!！/／#＃@＠"
    For i = 1 To Len(enteredName)
        characterValue = Mid$(enteredName, i, 1)
        If InStr(1, invalidCharacters, characterValue, vbBinaryCompare) > 0 Then
            warnings.Add "要確認：運転者氏名に数字または確認が必要な記号があります。"
            Exit For
        End If
    Next i
    If Len(compactName) = 1 Then warnings.Add "要確認：運転者氏名が極端に短いです。"
    If Len(compactName) = 0 Then
        Set 運転者名警告一覧 = warnings
        Exit Function
    End If

    If masterNames.Count > 0 Then
        For Each masterName In masterNames
            masterTrimmed = 運転者名の前後空白を除去(CStr(masterName))
            If trimmedName = masterTrimmed Then
                exactMasterMatch = True
                Exit For
            End If
        Next masterName
    End If
    If exactMasterMatch Then
        Set 運転者名警告一覧 = warnings
        Exit Function
    End If

    If exactCounts.Exists(enteredName) Then currentCount = CLng(exactCounts(enteredName))
    If currentCount = 1 And variantsByName.Exists(compactName) Then
        Set nameVariants = variantsByName(compactName)
        For Each otherName In nameVariants.Keys
            If CStr(otherName) <> enteredName And CLng(nameVariants(otherName)) >= 2 Then
                warnings.Add "要確認：同じ氏名と思われる別の空白表記が多く使われています。"
                Exit For
            End If
        Next otherName

        Set historyNearMatches = CreateObject("Scripting.Dictionary")
        For Each otherCompact In normalizedCounts.Keys
            If CStr(otherCompact) <> compactName And CLng(normalizedCounts(otherCompact)) >= 2 And _
               CLng(normalizedCounts(compactName)) < CLng(normalizedCounts(otherCompact)) Then
                If 運転者名の編集距離(compactName, CStr(otherCompact)) = 1 Then
                    historyNearMatches(CStr(otherCompact)) = 運転者名の履歴代表表記(CStr(otherCompact), variantsByName)
                End If
            End If
        Next otherCompact
        If historyNearMatches.Count = 1 Then
            For Each otherCompact In historyNearMatches.Keys
                warnings.Add "要確認：過去によく使われている「" & CStr(historyNearMatches(otherCompact)) & _
                             "」に近い運転者名です。漢字・入力内容を確認してください。"
            Next otherCompact
        ElseIf historyNearMatches.Count > 1 Then
            warnings.Add "要確認：過去によく使われている複数の運転者名に近い表記です。漢字・入力内容を確認してください。"
        End If
    End If

    If masterNames.Count > 0 Then
        Set spacingMatches = CreateObject("Scripting.Dictionary")
        Set masterNearMatches = CreateObject("Scripting.Dictionary")
        For Each masterName In masterNames
            masterTrimmed = 運転者名の前後空白を除去(CStr(masterName))
            compactMaster = 運転者名の空白を除去(masterTrimmed)
            If compactName = compactMaster Then spacingMatches(masterTrimmed) = True
            If 運転者名の編集距離(compactName, compactMaster) = 1 Then masterNearMatches(masterTrimmed) = True
        Next masterName
        If spacingMatches.Count = 1 Then
            For Each masterName In spacingMatches.Keys
                warnings.Add "要確認：登録済みの「" & CStr(masterName) & "」と空白表記が異なります。"
            Next masterName
        ElseIf spacingMatches.Count > 1 Then
            warnings.Add "要確認：空白表記が異なる登録済みの複数名が候補です。"
        ElseIf masterNearMatches.Count = 1 Then
            For Each masterName In masterNearMatches.Keys
                warnings.Add "要確認：登録済みの「" & CStr(masterName) & "」に近い運転者名です。漢字・入力内容を確認してください。"
            Next masterName
        ElseIf masterNearMatches.Count > 1 Then
            warnings.Add "要確認：登録済みの複数の運転者名に似ています。"
        Else
            warnings.Add "要確認：運転者名マスタにない初登場の名前です。正しい新規運転者であれば、確認後に運転者名マスタへ追加してください。"
        End If
    End If
    Set 運転者名警告一覧 = warnings
End Function

Private Function 運転者名の履歴代表表記(ByVal compactName As String, ByVal variantsByName As Object) As String
    Dim variants As Object, nameValue As Variant, highestCount As Long, tied As Boolean
    Set variants = variantsByName(compactName)
    For Each nameValue In variants.Keys
        If CLng(variants(nameValue)) > highestCount Then
            highestCount = CLng(variants(nameValue))
            運転者名の履歴代表表記 = CStr(nameValue)
            tied = False
        ElseIf CLng(variants(nameValue)) = highestCount Then
            tied = True
        End If
    Next nameValue
    If tied Then 運転者名の履歴代表表記 = compactName
End Function


Private Function 運転者名の前後空白を除去(ByVal sourceName As String) As String
    Dim firstPosition As Long, lastPosition As Long, currentChar As String
    firstPosition = 1: lastPosition = Len(sourceName)
    Do While firstPosition <= lastPosition
        currentChar = Mid$(sourceName, firstPosition, 1)
        If currentChar <> " " And currentChar <> "　" Then Exit Do
        firstPosition = firstPosition + 1
    Loop
    Do While lastPosition >= firstPosition
        currentChar = Mid$(sourceName, lastPosition, 1)
        If currentChar <> " " And currentChar <> "　" Then Exit Do
        lastPosition = lastPosition - 1
    Loop
    If lastPosition >= firstPosition Then 運転者名の前後空白を除去 = Mid$(sourceName, firstPosition, lastPosition - firstPosition + 1)
End Function

Private Function 運転者名の空白を除去(ByVal sourceName As String) As String
    運転者名の空白を除去 = Replace(Replace(sourceName, " ", ""), "　", "")
End Function

Private Function 運転者名の編集距離(ByVal leftName As String, ByVal rightName As String) As Long
    Dim distance() As Long, leftLength As Long, rightLength As Long, i As Long, j As Long, cost As Long
    leftLength = Len(leftName): rightLength = Len(rightName)
    If Abs(leftLength - rightLength) > 1 Then
        運転者名の編集距離 = 2
        Exit Function
    End If
    ReDim distance(0 To leftLength, 0 To rightLength)
    For i = 0 To leftLength
        distance(i, 0) = i
    Next i
    For j = 0 To rightLength
        distance(0, j) = j
    Next j
    For i = 1 To leftLength
        For j = 1 To rightLength
            cost = 0
            If Mid$(leftName, i, 1) <> Mid$(rightName, j, 1) Then cost = 1
            distance(i, j) = Application.Min(distance(i - 1, j) + 1, distance(i, j - 1) + 1, distance(i - 1, j - 1) + cost)
        Next j
    Next i
    運転者名の編集距離 = distance(leftLength, rightLength)
End Function

