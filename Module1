Private Sub セルの自動チェック警告を除去(ByVal target As Range, ByRef errorCount As Long)
    Call セルの自動チェック警告カテゴリを除去(target, errorCount, "通常チェック")
End Sub

Private Sub セルの自動チェック警告カテゴリを除去(ByVal target As Range, ByRef errorCount As Long, _
                                           ByVal category As String)
    Dim note As Comment, existingText As String, prefixText As String, suffixText As String
    Dim bodyText As String, retainedBody As String, metadataText As String
    Dim markerStart As Long, headerEnd As Long, markerEnd As Long, bodyStart As Long
    Dim cursor As Long, nextStart As Long, endPosition As Long, selectedPosition As Long
    Dim selectedStart As String, selectedEnd As String, selectedCategory As String
    Dim startMarkers As Variant, endMarkers As Variant, categoryNames As Variant
    Dim i As Long, originalColor As Long, originalBold As Boolean
    Dim markerText As String, rebuiltText As String, hasManagedWarnings As Boolean

    On Error GoTo RemoveFailed
    Set note = target.Comment
    If note Is Nothing Then Exit Sub
    existingText = note.Text
    markerStart = InStr(1, existingText, CHECK_WARNING_START, vbBinaryCompare)
    If markerStart = 0 Then Exit Sub
    headerEnd = InStr(markerStart, existingText, "】", vbBinaryCompare)
    If headerEnd = 0 Then
        errorCount = errorCount + 1
        Exit Sub
    End If
    markerEnd = InStr(headerEnd + 1, existingText, CHECK_WARNING_END, vbBinaryCompare)
    If markerEnd = 0 Then
        errorCount = errorCount + 1
        Exit Sub
    End If
    If InStr(markerEnd + Len(CHECK_WARNING_END), existingText, CHECK_WARNING_START, vbBinaryCompare) > 0 Then
        errorCount = errorCount + 1
        Exit Sub
    End If

    metadataText = Mid$(existingText, markerStart + Len(CHECK_WARNING_START), _
                        headerEnd - (markerStart + Len(CHECK_WARNING_START)))
    If Not 自動警告書式を取得(metadataText, originalColor, originalBold) Then
        errorCount = errorCount + 1
        Exit Sub
    End If
    bodyStart = headerEnd + Len("】") + Len(vbCrLf)
    bodyText = Mid$(existingText, bodyStart, markerEnd - bodyStart)
    prefixText = Left$(existingText, markerStart - 1)
    suffixText = Mid$(existingText, markerEnd + Len(CHECK_WARNING_END))

    startMarkers = Array("【通常チェック警告開始】", "【運転者名警告開始】", "【給油照合警告開始】")
    endMarkers = Array("【通常チェック警告終了】", "【運転者名警告終了】", "【給油照合警告終了】")
    categoryNames = Array("通常チェック", "運転者名警告", "給油照合警告")
    cursor = 1
    Do While cursor <= Len(bodyText)
        nextStart = 0
        selectedPosition = 0
        For i = LBound(startMarkers) To UBound(startMarkers)
            endPosition = InStr(cursor, bodyText, CStr(startMarkers(i)), vbBinaryCompare)
            If endPosition > 0 And (nextStart = 0 Or endPosition < nextStart) Then
                nextStart = endPosition
                selectedPosition = i
            End If
        Next i
        If nextStart = 0 Then
            If category <> "通常チェック" Then retainedBody = retainedBody & Mid$(bodyText, cursor)
            Exit Do
        End If
        If category <> "通常チェック" And nextStart > cursor Then
            retainedBody = retainedBody & Mid$(bodyText, cursor, nextStart - cursor)
        End If
        selectedStart = CStr(startMarkers(selectedPosition))
        selectedEnd = CStr(endMarkers(selectedPosition))
        selectedCategory = CStr(categoryNames(selectedPosition))
        endPosition = InStr(nextStart + Len(selectedStart), bodyText, selectedEnd, vbBinaryCompare)
        If endPosition = 0 Then
            If category <> "通常チェック" Then retainedBody = retainedBody & Mid$(bodyText, nextStart)
            Exit Do
        End If
        If selectedCategory <> category Then
            retainedBody = retainedBody & Mid$(bodyText, nextStart, endPosition + Len(selectedEnd) - nextStart)
        End If
        cursor = endPosition + Len(selectedEnd)
    Loop

    hasManagedWarnings = (Len(Trim$(retainedBody)) > 0)
    If hasManagedWarnings Then
        markerText = Mid$(existingText, markerStart, headerEnd - markerStart + Len("】"))
        rebuiltText = prefixText & markerText & vbCrLf & retainedBody & vbCrLf & _
                      CHECK_WARNING_END & suffixText
        note.Text Text:=rebuiltText
        target.Font.Color = vbRed
        target.Font.Bold = True
    Else
        rebuiltText = prefixText & suffixText
        If target.Font.Color = vbRed And target.Font.Bold = True Then
            target.Font.Color = originalColor
            target.Font.Bold = originalBold
        End If
        If Len(Trim$(rebuiltText)) = 0 Then
            note.Delete
        Else
            note.Text Text:=rebuiltText
        End If
    End If
    Exit Sub
RemoveFailed:
    errorCount = errorCount + 1
    Err.Clear
End Sub

Private Function 自動警告書式を取得(ByVal metadataText As String, ByRef originalColor As Long, _
                                   ByRef originalBold As Boolean) As Boolean
    Dim parts As Variant
    parts = Split(metadataText, "|")
    If UBound(parts) <> 1 Then Exit Function
    If Not IsNumeric(parts(0)) Or Not IsNumeric(parts(1)) Then Exit Function
    originalColor = CLng(parts(0))
    originalBold = (CLng(parts(1)) <> 0)
    自動警告書式を取得 = True
End Function

Private Sub 自動チェック警告を追加(ByVal target As Range, ByVal warningText As String, _
                                ByRef errorCount As Long, Optional ByVal category As String = "通常チェック")
    Dim note As Comment, existingText As String, newText As String, markerText As String
    Dim bodyText As String, newBody As String, markerStart As Long, headerEnd As Long, markerEnd As Long
    Dim bodyStart As Long, metadataText As String, startMarker As String, endMarker As String
    Dim originalColor As Long, originalBold As Boolean, createdComment As Boolean
    Dim prefixText As String, suffixText As String, currentCategoryText As String
    Dim categoryStart As Long, categoryEnd As Long, markerHeader As String

    On Error GoTo AddFailed
    Set note = target.Comment
    If note Is Nothing Then
        target.AddComment
        Set note = target.Comment
        createdComment = True
        existingText = ""
    Else
        existingText = note.Text
    End If

    markerStart = InStr(1, existingText, CHECK_WARNING_START, vbBinaryCompare)
    If markerStart > 0 Then
        headerEnd = InStr(markerStart, existingText, "】", vbBinaryCompare)
        If headerEnd = 0 Then GoTo AddFailed
        markerEnd = InStr(headerEnd + 1, existingText, CHECK_WARNING_END, vbBinaryCompare)
        If markerEnd = 0 Then GoTo AddFailed
        If InStr(markerEnd + Len(CHECK_WARNING_END), existingText, CHECK_WARNING_START, vbBinaryCompare) > 0 Then GoTo AddFailed
        metadataText = Mid$(existingText, markerStart + Len(CHECK_WARNING_START), _
                            headerEnd - (markerStart + Len(CHECK_WARNING_START)))
        If Not 自動警告書式を取得(metadataText, originalColor, originalBold) Then GoTo AddFailed
        bodyStart = headerEnd + Len("】") + Len(vbCrLf)
        bodyText = Mid$(existingText, bodyStart, markerEnd - bodyStart)
        prefixText = Left$(existingText, markerStart - 1)
        suffixText = Mid$(existingText, markerEnd + Len(CHECK_WARNING_END))
        markerHeader = Mid$(existingText, markerStart, headerEnd - markerStart + Len("】"))
    Else
        prefixText = existingText
        suffixText = ""
        bodyText = ""
        originalColor = CLng(target.Font.Color)
        originalBold = CBool(target.Font.Bold)
        markerHeader = CHECK_WARNING_START & CStr(originalColor) & "|" & _
                       CStr(Abs(CLng(originalBold))) & "】"
    End If

    startMarker = 自動警告カテゴリ開始(category)
    endMarker = 自動警告カテゴリ終了(category)
    If Len(startMarker) = 0 Or Len(endMarker) = 0 Then GoTo AddFailed
    categoryStart = InStr(1, bodyText, startMarker, vbBinaryCompare)
    If categoryStart > 0 Then
        categoryEnd = InStr(categoryStart + Len(startMarker), bodyText, endMarker, vbBinaryCompare)
    Else
        categoryEnd = 0
    End If
    If categoryStart > 0 And categoryEnd > 0 Then
        currentCategoryText = Mid$(bodyText, categoryStart + Len(startMarker), _
                                  categoryEnd - categoryStart - Len(startMarker))
        If InStr(1, currentCategoryText, warningText, vbBinaryCompare) = 0 Then
            If Len(currentCategoryText) > 0 Then currentCategoryText = currentCategoryText & vbCrLf
            currentCategoryText = currentCategoryText & warningText
        End If
        newBody = Left$(bodyText, categoryStart - 1) & startMarker & currentCategoryText & endMarker & _
                  Mid$(bodyText, categoryEnd + Len(endMarker))
    Else
        If Len(bodyText) > 0 Then bodyText = bodyText & vbCrLf
        newBody = bodyText & startMarker & warningText & endMarker
    End If

    markerText = markerHeader & vbCrLf & newBody & vbCrLf & CHECK_WARNING_END
    If Len(prefixText) > 0 And Right$(prefixText, Len(vbCrLf)) <> vbCrLf Then prefixText = prefixText & vbCrLf
    newText = prefixText & markerText & suffixText
    note.Text Text:=newText
    target.Font.Color = vbRed
    target.Font.Bold = True
    Exit Sub
AddFailed:
    If createdComment Then
        On Error Resume Next
        note.Delete
        On Error GoTo 0
    End If
    errorCount = errorCount + 1
    Err.Clear
End Sub

Private Function 自動警告カテゴリ開始(ByVal category As String) As String
    Select Case category
        Case "通常チェック": 自動警告カテゴリ開始 = "【通常チェック警告開始】"
        Case "運転者名警告": 自動警告カテゴリ開始 = "【運転者名警告開始】"
        Case "給油照合警告": 自動警告カテゴリ開始 = "【給油照合警告開始】"
    End Select
End Function

Private Function 自動警告カテゴリ終了(ByVal category As String) As String
    Select Case category
        Case "通常チェック": 自動警告カテゴリ終了 = "【通常チェック警告終了】"
        Case "運転者名警告": 自動警告カテゴリ終了 = "【運転者名警告終了】"
        Case "給油照合警告": 自動警告カテゴリ終了 = "【給油照合警告終了】"
    End Select
End Function

Private Sub 車両選択候補をチェック(ByVal ws As Worksheet, ByVal lastRow As Long, _
                                 ByRef errorCount As Long, Optional ByVal 警告を追加 As Boolean = True)
    Dim vehicleNames() As String, rowVehicleIndex() As Long
    Dim rowStartDateTime() As Double, rowEndDateTime() As Double, rowTimesValid() As Boolean
    Dim rowEndMeterValid() As Boolean, rowEndMeter() As Double
    Dim previousFound() As Boolean, nextFound() As Boolean, vehicleOverlaps() As Boolean
    Dim previousDateTime() As Double, nextDateTime() As Double
    Dim previousMeterValid() As Boolean, nextMeterValid() As Boolean
    Dim previousMeter() As Double, nextMeter() As Double
    Dim vehicleCount As Long, rowNo As Long, otherRow As Long, vehicleIndex As Long, assignedIndex As Long
    Dim currentVehicle As String, vehicleValue As Variant, currentStart As Double, currentEnd As Double
    Dim assignedMismatch As Boolean, candidateCount As Long, candidateIndex As Long, warningText As String
    Dim candidateInfo As Object

    If lastRow < 3 Then Exit Sub
    Set vehicleReviewCandidates = New Collection
    ReDim vehicleNames(1 To lastRow - 1)
    ReDim rowVehicleIndex(1 To lastRow)
    ReDim rowStartDateTime(1 To lastRow)
    ReDim rowEndDateTime(1 To lastRow)
    ReDim rowTimesValid(1 To lastRow)
    ReDim rowEndMeterValid(1 To lastRow)
    ReDim rowEndMeter(1 To lastRow)

    For rowNo = 2 To lastRow
        vehicleValue = ws.Cells(rowNo, "J").Value
        If Not IsError(vehicleValue) And Not IsEmpty(vehicleValue) Then
            currentVehicle = Trim$(CStr(vehicleValue))
            If Len(currentVehicle) > 0 Then
                For vehicleIndex = 1 To vehicleCount
                    If StrComp(vehicleNames(vehicleIndex), currentVehicle, vbTextCompare) = 0 Then Exit For
                Next vehicleIndex
                If vehicleIndex > vehicleCount Then
                    vehicleCount = vehicleCount + 1
                    vehicleNames(vehicleCount) = currentVehicle
                    vehicleIndex = vehicleCount
                End If
                rowVehicleIndex(rowNo) = vehicleIndex
            End If
        End If

        rowTimesValid(rowNo) = 日付と時刻を取得(ws.Cells(rowNo, "K").Value, _
                                             ws.Cells(rowNo, "N").Value, rowStartDateTime(rowNo)) And _
                               日付と時刻を取得(ws.Cells(rowNo, "K").Value, _
                                             ws.Cells(rowNo, "O").Value, rowEndDateTime(rowNo))
        If rowTimesValid(rowNo) Then
            If rowEndDateTime(rowNo) < rowStartDateTime(rowNo) Then rowTimesValid(rowNo) = False
        End If
        rowEndMeterValid(rowNo) = 数値入力あり(ws.Cells(rowNo, "Q").Value)
        If rowEndMeterValid(rowNo) Then rowEndMeter(rowNo) = CDbl(ws.Cells(rowNo, "Q").Value)
    Next rowNo
    If vehicleCount < 2 Then Exit Sub

    For rowNo = 2 To lastRow
        assignedIndex = rowVehicleIndex(rowNo)
        If assignedIndex = 0 Or Not rowTimesValid(rowNo) Or Not rowEndMeterValid(rowNo) Then GoTo NextVehicleRecord
        currentStart = rowStartDateTime(rowNo)
        currentEnd = rowEndDateTime(rowNo)
        ReDim previousFound(1 To vehicleCount)
        ReDim nextFound(1 To vehicleCount)
        ReDim vehicleOverlaps(1 To vehicleCount)
        ReDim previousDateTime(1 To vehicleCount)
        ReDim nextDateTime(1 To vehicleCount)
        ReDim previousMeterValid(1 To vehicleCount)
        ReDim nextMeterValid(1 To vehicleCount)
        ReDim previousMeter(1 To vehicleCount)
        ReDim nextMeter(1 To vehicleCount)

        For otherRow = 2 To lastRow
            vehicleIndex = rowVehicleIndex(otherRow)
            If otherRow <> rowNo And vehicleIndex > 0 And rowTimesValid(otherRow) Then
                If rowStartDateTime(otherRow) < currentEnd And rowEndDateTime(otherRow) > currentStart Then
                    vehicleOverlaps(vehicleIndex) = True
                End If
                If rowEndDateTime(otherRow) <= currentStart Then
                    If Not previousFound(vehicleIndex) Or rowEndDateTime(otherRow) > previousDateTime(vehicleIndex) Then
                        previousFound(vehicleIndex) = True
                        previousDateTime(vehicleIndex) = rowEndDateTime(otherRow)
                        previousMeterValid(vehicleIndex) = rowEndMeterValid(otherRow)
                        If rowEndMeterValid(otherRow) Then previousMeter(vehicleIndex) = rowEndMeter(otherRow)
                    End If
                End If
                If rowStartDateTime(otherRow) >= currentEnd Then
                    If Not nextFound(vehicleIndex) Or rowStartDateTime(otherRow) < nextDateTime(vehicleIndex) Then
                        nextFound(vehicleIndex) = True
                        nextDateTime(vehicleIndex) = rowStartDateTime(otherRow)
                        nextMeterValid(vehicleIndex) = rowEndMeterValid(otherRow)
                        If rowEndMeterValid(otherRow) Then nextMeter(vehicleIndex) = rowEndMeter(otherRow)
                    End If
                End If
            End If
        Next otherRow

        assignedMismatch = previousFound(assignedIndex) And nextFound(assignedIndex) And _
                           previousMeterValid(assignedIndex) And nextMeterValid(assignedIndex)
        If assignedMismatch Then
            assignedMismatch = rowEndMeter(rowNo) < previousMeter(assignedIndex) - CHECK_VEHICLE_SELECTION_ODO_TOLERANCE_KM Or _
                               rowEndMeter(rowNo) > nextMeter(assignedIndex) + CHECK_VEHICLE_SELECTION_ODO_TOLERANCE_KM
        End If
        If Not assignedMismatch Then GoTo NextVehicleRecord

        candidateCount = 0
        candidateIndex = 0
        For vehicleIndex = 1 To vehicleCount
            If vehicleIndex <> assignedIndex And Not vehicleOverlaps(vehicleIndex) And _
               previousFound(vehicleIndex) And nextFound(vehicleIndex) And _
               previousMeterValid(vehicleIndex) And nextMeterValid(vehicleIndex) Then
                If previousMeter(vehicleIndex) <= rowEndMeter(rowNo) + CHECK_VEHICLE_SELECTION_ODO_TOLERANCE_KM And _
                   rowEndMeter(rowNo) <= nextMeter(vehicleIndex) + CHECK_VEHICLE_SELECTION_ODO_TOLERANCE_KM Then
                    candidateCount = candidateCount + 1
                    candidateIndex = vehicleIndex
                End If
            End If
        Next vehicleIndex

        If candidateCount = 1 Then
            Set candidateInfo = CreateObject("Scripting.Dictionary")
            candidateInfo.Add "回答番号", セル値を表示(ws.Cells(rowNo, "A").Value)
            candidateInfo.Add "登録車両", vehicleNames(assignedIndex)
            candidateInfo.Add "候補車両", vehicleNames(candidateIndex)
            candidateInfo.Add "運転日", Format$(Fix(rowStartDateTime(rowNo)), "yyyy/m/d")
            candidateInfo.Add "使用時間", Format$(rowStartDateTime(rowNo), "hh:mm") & "～" & Format$(rowEndDateTime(rowNo), "hh:mm")
            candidateInfo.Add "運転者", セル値を表示(ws.Cells(rowNo, "W").Value)
            candidateInfo.Add "行先", セル値を表示(ws.Cells(rowNo, "R").Value)
            candidateInfo.Add "用務", セル値を表示(ws.Cells(rowNo, "T").Value)
            candidateInfo.Add "登録推移", Format$(previousMeter(assignedIndex), "0.##") & " → " & Format$(rowEndMeter(rowNo), "0.##") & " → " & Format$(nextMeter(assignedIndex), "0.##")
            candidateInfo.Add "候補推移", Format$(previousMeter(candidateIndex), "0.##") & " → " & Format$(rowEndMeter(rowNo), "0.##") & " → " & Format$(nextMeter(candidateIndex), "0.##")
            vehicleReviewCandidates.Add candidateInfo
            If 警告を追加 Then
                warningText = "要確認：車両選択間違いの可能性があります。" & vbCrLf & vbCrLf & _
                          "回答番号：" & セル値を表示(ws.Cells(rowNo, "A").Value) & vbCrLf & _
                          "運転日：" & Format$(Fix(rowStartDateTime(rowNo)), "yyyy/m/d") & vbCrLf & _
                          "使用時間：" & Format$(rowStartDateTime(rowNo), "hh:mm") & "～" & Format$(rowEndDateTime(rowNo), "hh:mm") & vbCrLf & _
                          "運転者：" & セル値を表示(ws.Cells(rowNo, "W").Value) & vbCrLf
            If セルに値がある(ws.Cells(rowNo, "R").Value) Then warningText = warningText & "行先：" & セル値を表示(ws.Cells(rowNo, "R").Value) & vbCrLf
            If セルに値がある(ws.Cells(rowNo, "T").Value) Then warningText = warningText & "用務：" & セル値を表示(ws.Cells(rowNo, "T").Value) & vbCrLf
            warningText = warningText & vbCrLf & _
                          "登録車両：" & vehicleNames(assignedIndex) & vbCrLf & _
                          "候補車両：" & vehicleNames(candidateIndex) & vbCrLf & vbCrLf & _
                          "【登録車両 " & vehicleNames(assignedIndex) & " のメーター推移】" & vbCrLf & _
                          Format$(previousMeter(assignedIndex), "0.##") & " → " & Format$(rowEndMeter(rowNo), "0.##") & " → " & Format$(nextMeter(assignedIndex), "0.##") & vbCrLf & vbCrLf & _
                          "【候補車両 " & vehicleNames(candidateIndex) & " のメーター推移】" & vbCrLf & _
                          Format$(previousMeter(candidateIndex), "0.##") & " → " & Format$(rowEndMeter(rowNo), "0.##") & " → " & Format$(nextMeter(candidateIndex), "0.##") & vbCrLf & vbCrLf & _
                          vehicleNames(candidateIndex) & "号車として扱う方がメーター推移と時間関係が自然です。" & vbCrLf & _
                          "実際に使用した車両を確認してください。"
            Call 自動チェック警告を追加(ws.Cells(rowNo, "J"), warningText, errorCount)
            End If
        End If
NextVehicleRecord:
    Next rowNo
End Sub

Public Function 車両候補確認一覧を取得() As Collection
    If vehicleReviewCandidates Is Nothing Then Set vehicleReviewCandidates = New Collection
    Set 車両候補確認一覧を取得 = vehicleReviewCandidates
End Function

Private Sub 車両候補確認画面を表示()
    Dim reviewForm As Object
    If vehicleReviewIsOpen Then Exit Sub
    If vehicleReviewCandidates Is Nothing Then Exit Sub
    If vehicleReviewCandidates.Count = 0 Then Exit Sub
    On Error GoTo FormUnavailable
    Set reviewForm = VBA.UserForms.Add("frmVehicleReview")
    vehicleReviewIsOpen = True
    reviewForm.候補を読み込む vehicleReviewCandidates
    reviewForm.Show vbModeless
    Exit Sub
FormUnavailable:
    vehicleReviewIsOpen = False
    MsgBox "車両候補確認フォーム（frmVehicleReview）が読み込めません。" & vbCrLf & _
           "通常の内容チェックは完了しています。職場Excelへフォームをインポートしてから再実行してください。", vbExclamation
    Err.Clear
End Sub

Public Sub 車両候補の対象行へ移動(ByVal answerNumber As String)
    Dim ws As Worksheet, rowNo As Long, foundRow As Long, matches As Long
    Set ws = ThisWorkbook.Sheets("記録")
    For rowNo = 2 To ws.Cells(ws.Rows.Count, "A").End(xlUp).Row
        If セル値を表示(ws.Cells(rowNo, "A").Value) = answerNumber Then matches = matches + 1: foundRow = rowNo
    Next rowNo
    If matches = 1 Then
        ws.Activate
        ws.Cells(foundRow, "J").Select
    Else
        MsgBox "回答番号 " & answerNumber & " を一意に特定できません。再チェックしてください。", vbExclamation
    End If
End Sub

Private Sub 最新の車両候補を再判定()
    Dim ws As Worksheet, lastRow As Long, ignoredErrors As Long
    Set ws = ThisWorkbook.Sheets("記録")
    lastRow = ws.Cells(ws.Rows.Count, "A").End(xlUp).Row
    Set vehicleReviewCandidates = New Collection
    If lastRow >= 3 Then Call 車両選択候補をチェック(ws, lastRow, ignoredErrors, False)
End Sub

Public Function 車両候補を承認して修正(ByVal answerNumber As String, ByVal expectedVehicle As String, _
                                      ByVal expectedCandidate As String) As Boolean
    Dim ws As Worksheet, rowNo As Long, foundRow As Long, matches As Long, item As Object, currentCandidate As Object
    Set ws = ThisWorkbook.Sheets("記録")
    Call 最新の車両候補を再判定
    For Each item In vehicleReviewCandidates
        If CStr(item("回答番号")) = answerNumber And CStr(item("登録車両")) = expectedVehicle And _
           CStr(item("候補車両")) = expectedCandidate Then Set currentCandidate = item: Exit For
    Next item
    If currentCandidate Is Nothing Then
        MsgBox "対象記録の条件が変わったため修正しませんでした。内容チェックをやり直してください。", vbExclamation
        Exit Function
    End If
    For rowNo = 2 To ws.Cells(ws.Rows.Count, "A").End(xlUp).Row
        If セル値を表示(ws.Cells(rowNo, "A").Value) = answerNumber Then matches = matches + 1: foundRow = rowNo
    Next rowNo
    If matches <> 1 Or Trim$(CStr(ws.Cells(foundRow, "J").Value)) <> expectedVehicle Then
        MsgBox "回答番号または現在の車両番号を一意に確認できないため修正しませんでした。", vbExclamation
        Exit Function
    End If
    ws.Cells(foundRow, "J").Value = expectedCandidate
    vehicleReviewHasChanges = True
    車両候補を承認して修正 = True
End Function

Public Sub 車両候補確認を終了()
    vehicleReviewIsOpen = False
    If vehicleReviewHasChanges Then
        vehicleReviewHasChanges = False
        Call 記録シート整理を実行(False)
    End If
End Sub

Private Sub 車両選択候補の事前チェック(ByVal ws As Worksheet, ByVal lastRow As Long)
    Dim rowNo As Long, commentFailures As Long
    For rowNo = 2 To lastRow
        Call セルの自動チェック警告を除去(ws.Cells(rowNo, "J"), commentFailures)
    Next rowNo
    Call 車両選択候補をチェック(ws, lastRow, commentFailures)
    If commentFailures > 0 Then
        MsgBox "車両選択候補の事前チェックで、" & commentFailures & _
               "セルの警告コメントまたは既存コメントを処理できませんでした。該当セルを確認してください。", vbExclamation
    End If
End Sub

Sub 記録シート整理()
    Call 記録シート整理を実行(True)
End Sub

Private Sub 記録シート整理を実行(ByVal 結果表示 As Boolean)
    Dim ws As Worksheet
    Set ws = ThisWorkbook.Sheets("記録")

    Dim lastRow As Long
    lastRow = ws.Cells(ws.Rows.Count, "A").End(xlUp).Row
    If lastRow < 3 Then
        MsgBox "データが不足しています。", vbExclamation
        Exit Sub
    End If

    ' P列を誤った登録車両の前回Qで補完する前に、Q列と日時だけで候補を確認する。
    Call 車両選択候補の事前チェック(ws, lastRow)

    ' 並び替え（2行目から）
    With ws.Sort
        .SortFields.Clear
        .SortFields.Add Key:=ws.Range("J2:J" & lastRow), Order:=xlAscending
        .SortFields.Add Key:=ws.Range("K2:K" & lastRow), Order:=xlAscending
        .SortFields.Add Key:=ws.Range("N2:N" & lastRow), Order:=xlAscending
        .SetRange ws.Range("A2:AO" & lastRow)
        .Header = xlNo ' ヘッダーなしで並び替える
        .Apply
    End With

    ' 自動補完処理（P列：始業時メーター）
    Dim i As Long
    Dim current車両 As String, previous車両 As String
    Dim previousメーター As Variant

    previous車両 = ""
    previousメーター = ""

    For i = 2 To lastRow
        current車両 = ws.Cells(i, "J").Value

        If current車両 = previous車両 And IsNumeric(previousメーター) Then
            ws.Cells(i, "P").Value = previousメーター
        End If

        previous車両 = current車両
        previousメーター = ws.Cells(i, "Q").Value
    Next i

    Call 入力内容チェック実行(False)

    If 結果表示 Then MsgBox "並び替えと始業時メーターの補完が完了しました。", vbInformation
End Sub

Public Sub 給油記録を照合()
    Call 給油記録を照合実行(True)
End Sub

Private Function 給油記録を照合実行(ByVal 結果表示 As Boolean) As Boolean
    Dim ticketWS As Worksheet, logWS As Worksheet
    Dim tickets As Collection, logs As Collection
    Dim statuses As Object, matches As Object, usedTickets As Object, usedLogs As Object
    Dim reservedSameDayTickets As Object, reservedSameDayLogs As Object
    Dim gasCol As Long

    On Error GoTo Failed
    Set ticketWS = ThisWorkbook.Worksheets("給油記録")
    Set logWS = ThisWorkbook.Worksheets("記録")
    gasCol = HeaderColumn(logWS, GASOLINE_FUEL_HEADER)
    If gasCol = 0 Then
        MsgBox "記録シートのガソリン給油列が見つかりません。", vbExclamation
        Exit Function
    End If
    If Not PrepareTicketOutput(ticketWS) Then Exit Function

    Set statuses = CreateObject("Scripting.Dictionary")
    Set tickets = ReadTickets(ticketWS, statuses)
    Set logs = ReadLogs(logWS, gasCol)
    Set matches = CreateObject("Scripting.Dictionary")
    Set usedTickets = CreateObject("Scripting.Dictionary")
    Set usedLogs = CreateObject("Scripting.Dictionary")
    Set reservedSameDayTickets = CreateObject("Scripting.Dictionary")
    Set reservedSameDayLogs = CreateObject("Scripting.Dictionary")

    ResolveStage tickets, logs, usedTickets, usedLogs, matches, reservedSameDayTickets, reservedSameDayLogs, True
    ReserveAmbiguousSameDay tickets, logs, usedTickets, usedLogs, reservedSameDayTickets, reservedSameDayLogs
    ResolveStage tickets, logs, usedTickets, usedLogs, matches, reservedSameDayTickets, reservedSameDayLogs, False
    SetRemainingStatuses tickets, logs, statuses, usedTickets, usedLogs, matches, reservedSameDayTickets, reservedSameDayLogs
    If Not ResetManagedTicketOutput(ticketWS) Then Exit Function
    WriteTicketResults ticketWS, tickets, statuses, matches
    Call 給油警告を記録シートへ反映(ticketWS, logWS, gasCol)

    If 結果表示 Then MsgBox "給油記録の照合が完了しました。", vbInformation
    給油記録を照合実行 = True
    Exit Function
Failed:
    MsgBox "給油照合を中止しました。" & Err.Description, vbExclamation
End Function

Private Sub 給油警告を記録シートへ反映(ByVal ticketWS As Worksheet, ByVal logWS As Worksheet, ByVal gasCol As Long)
    Dim lastTicketRow As Long, lastLogRow As Long, rowNo As Long, ticketRow As Long
    Dim ticketDate As Double, ticketAmount As Double, car As String
    Dim statusText As String, answer As String, warningText As String, dateText As String
    Dim rowsToWarn As Collection, ticketItem As Variant, logItem As Variant, candidateLog As Variant
    Dim tickets As Collection, logs As Collection, ticketStatus As Object
    Dim usedAnswers As Object, reservedAnswers As Object
    Dim noteFailures As Long, unlocatedCount As Long, exactCandidateCount As Long

    On Error GoTo Failed
    lastLogRow = Application.Max(logWS.Cells(logWS.Rows.Count, "A").End(xlUp).Row, _
                                 logWS.Cells(logWS.Rows.Count, "J").End(xlUp).Row, _
                                 logWS.Cells(logWS.Rows.Count, "K").End(xlUp).Row, _
                                 logWS.Cells(logWS.Rows.Count, gasCol).End(xlUp).Row)
    Call セルの自動チェック警告カテゴリを除去(logWS.Cells(1, gasCol), noteFailures, "給油照合警告")
    For rowNo = 2 To lastLogRow
        Call セルの自動チェック警告カテゴリを除去(logWS.Cells(rowNo, gasCol), noteFailures, "給油照合警告")
    Next rowNo

    Set ticketStatus = CreateObject("Scripting.Dictionary")
    Set tickets = ReadTickets(ticketWS, ticketStatus)
    Set logs = ReadLogs(logWS, gasCol)
    Set usedAnswers = CreateObject("Scripting.Dictionary")
    Set reservedAnswers = CreateObject("Scripting.Dictionary")
    lastTicketRow = LastTicketInputRow(ticketWS)
    For ticketRow = 2 To lastTicketRow
        If Not IsError(ticketWS.Cells(ticketRow, "D").Value) Then
            statusText = Trim$(CStr(ticketWS.Cells(ticketRow, "D").Value))
            If (statusText = "同日一致" Or statusText = "後日一致") And Not IsError(ticketWS.Cells(ticketRow, "F").Value) Then
                answer = Trim$(CStr(ticketWS.Cells(ticketRow, "F").Value))
                If Len(answer) > 0 Then usedAnswers(answer) = True
            End If
        End If
    Next ticketRow
    For Each ticketItem In tickets
        If Trim$(CStr(ticketWS.Cells(CLng(ticketItem(0)), "D").Value)) = "候補複数・要確認" Then
            For Each logItem In logs
                If IsCandidate(ticketItem, logItem, True) Then
                    If Not usedAnswers.Exists(CStr(logItem(0))) Then reservedAnswers(CStr(logItem(0))) = True
                End If
            Next logItem
        End If
    Next ticketItem

    For ticketRow = 2 To lastTicketRow
        If Not IsError(ticketWS.Cells(ticketRow, "D").Value) Then
            statusText = Trim$(CStr(ticketWS.Cells(ticketRow, "D").Value))
            If statusText = "未照合" Then
                If Not IsError(ticketWS.Cells(ticketRow, "A").Value) And Not IsError(ticketWS.Cells(ticketRow, "B").Value) And _
                   Not IsError(ticketWS.Cells(ticketRow, "C").Value) Then
                    If IsDate(ticketWS.Cells(ticketRow, "A").Value) And _
                       PositiveAmount(ticketWS.Cells(ticketRow, "C").Value, ticketAmount) Then
                        car = Trim$(CStr(ticketWS.Cells(ticketRow, "B").Value))
                        ticketDate = Fix(CDbl(CDate(ticketWS.Cells(ticketRow, "A").Value)))
                        Set rowsToWarn = New Collection
                        For rowNo = 2 To lastLogRow
                            If Not IsError(logWS.Cells(rowNo, "J").Value) And Not IsError(logWS.Cells(rowNo, "K").Value) Then
                                If Trim$(CStr(logWS.Cells(rowNo, "J").Value)) = car And IsDate(logWS.Cells(rowNo, "K").Value) Then
                                    If Fix(CDbl(CDate(logWS.Cells(rowNo, "K").Value))) = ticketDate Then rowsToWarn.Add rowNo
                                End If
                            End If
                        Next rowNo
                        If rowsToWarn.Count = 0 Then
                            unlocatedCount = unlocatedCount + 1
                        Else
                            dateText = Format$(CDate(ticketDate), "m月d日")
                            If rowsToWarn.Count = 1 Then
                                warningText = "要確認：給油記録に" & vbCrLf & dateText & "・" & car & "号車・" & _
                                              Format$(ticketAmount, "0.##") & "Lのチケットがありますが、" & vbCrLf & _
                                              "対応する給油入力が確認できません。" & vbCrLf & vbCrLf & _
                                              "チケット発行日と実際の給油日が異なる可能性も含めて確認してください。"
                            Else
                                warningText = "この日の給油チケットが未照合です。どの運転記録に対応するか確認してください。"
                            End If
                            For Each ticketItem In rowsToWarn
                                Call 自動チェック警告を追加(logWS.Cells(CLng(ticketItem), gasCol), warningText, noteFailures, "給油照合警告")
                            Next ticketItem
                        End If
                    End If
                End If
            ElseIf statusText = "候補複数・要確認" Then
                For Each ticketItem In tickets
                    If CStr(ticketItem(0)) = CStr(ticketRow) Then
                        Set rowsToWarn = New Collection
                        exactCandidateCount = 0
                        ticketDate = Fix(CDbl(CDate(ticketItem(1))))
                        For Each logItem In logs
                            If IsCandidate(ticketItem, logItem, True) And Not usedAnswers.Exists(CStr(logItem(0))) Then
                                rowsToWarn.Add logItem
                                exactCandidateCount = exactCandidateCount + 1
                            End If
                        Next logItem
                        If exactCandidateCount = 0 Then
                            For Each logItem In logs
                                If IsCandidate(ticketItem, logItem, False) And Not usedAnswers.Exists(CStr(logItem(0))) And _
                                   Not reservedAnswers.Exists(CStr(logItem(0))) Then rowsToWarn.Add logItem
                            Next logItem
                        End If
                        warningText = "要確認：この給油記録には複数の照合候補があります。" & vbCrLf & _
                                      "自動確定していません。給油記録シートを確認してください。"
                        For Each candidateLog In rowsToWarn
                            answer = CStr(candidateLog(0))
                            For rowNo = 2 To lastLogRow
                                If Not IsError(logWS.Cells(rowNo, "A").Value) Then
                                    If Trim$(CStr(logWS.Cells(rowNo, "A").Value)) = answer Then
                                        Call 自動チェック警告を追加(logWS.Cells(rowNo, gasCol), warningText, noteFailures, "給油照合警告")
                                        Exit For
                                    End If
                                End If
                            Next rowNo
                        Next candidateLog
                        Exit For
                    End If
                Next ticketItem
            End If
        End If
    Next ticketRow

    If unlocatedCount > 0 Then
        warningText = "要確認：給油記録シートに、記録シート上で対応先を特定できない未照合チケットが" & _
                      CStr(unlocatedCount) & "件あります。詳細は給油記録シートD:Gを確認してください。"
        Call 自動チェック警告を追加(logWS.Cells(1, gasCol), warningText, noteFailures, "給油照合警告")
    End If
    If noteFailures > 0 Then MsgBox "給油照合警告の" & noteFailures & "セルでコメントまたは書式を処理できませんでした。確認してください。", vbExclamation
    Exit Sub
Failed:
    MsgBox "記録シートへの給油警告反映を中止しました。" & Err.Description, vbExclamation
    Err.Clear
End Sub

Private Function PrepareTicketOutput(ws As Worksheet) As Boolean
    Dim r As Long, lastRow As Long, activeRow As Boolean, hasOutput As Boolean

    lastRow = LastTicketInputRow(ws)
    If Not HeadersAreSafe(ws) Then
        MsgBox "給油記録シートのD:H見出しに管理外の値があります。上書きしないため中止しました。", vbExclamation
        Exit Function
    End If

    For r = 2 To lastRow
        activeRow = TicketRowHasInput(ws, r)
        hasOutput = Application.WorksheetFunction.CountA(ws.Range("D" & r & ":H" & r)) > 0
        If activeRow And hasOutput And Trim$(CStr(ws.Cells(r, "H").Value)) <> FUEL_OUTPUT_MARKER Then
            MsgBox "給油記録の入力行に、このマクロ以外のD:H既存値があります。上書きしないため中止しました。", vbExclamation
            Exit Function
        End If
    Next r
    PrepareTicketOutput = True
End Function

Private Function ResetManagedTicketOutput(ws As Worksheet) As Boolean
    Dim r As Long, lastRow As Long
    lastRow = LastTicketSheetRow(ws)
    For r = 2 To lastRow
        If Not IsError(ws.Cells(r, "H").Value) Then
            If Trim$(CStr(ws.Cells(r, "H").Value)) = FUEL_OUTPUT_MARKER Then ws.Range("D" & r & ":H" & r).ClearContents
        End If
    Next r
    ws.Range("D1:H1").Value = Array("照合結果", "実給油日", "LoGo回答番号", "備考", "管理マーカー")
    ResetManagedTicketOutput = True
End Function

Private Function LastTicketSheetRow(ws As Worksheet) As Long
    Dim c As Long, candidate As Long
    For c = 1 To 8
        candidate = ws.Cells(ws.Rows.Count, c).End(xlUp).Row
        If candidate > LastTicketSheetRow Then LastTicketSheetRow = candidate
    Next c
End Function

Private Function HeadersAreSafe(ws As Worksheet) As Boolean
    Dim expected As Variant, c As Long, currentValue As String
    expected = Array("照合結果", "実給油日", "LoGo回答番号", "備考", "管理マーカー")
    For c = 0 To 4
        currentValue = Trim$(CStr(ws.Cells(1, "D").Offset(0, c).Value))
        If Len(currentValue) > 0 And currentValue <> expected(c) Then Exit Function
    Next c
    HeadersAreSafe = True
End Function

Private Function LastTicketInputRow(ws As Worksheet) As Long
    Dim c As Long, candidate As Long
    For c = 1 To 3
        candidate = ws.Cells(ws.Rows.Count, c).End(xlUp).Row
        If candidate > LastTicketInputRow Then LastTicketInputRow = candidate
    Next c
End Function

Private Function TicketRowHasInput(ws As Worksheet, ByVal rowNo As Long) As Boolean
    TicketRowHasInput = Application.WorksheetFunction.CountA(ws.Range("A" & rowNo & ":C" & rowNo)) > 0
End Function

Private Function ReadTickets(ws As Worksheet, statuses As Object) As Collection
    Dim result As New Collection, r As Long, lastRow As Long, amount As Double, car As String
    lastRow = LastTicketInputRow(ws)
    For r = 2 To lastRow
        If TicketRowHasInput(ws, r) Then
            If IsError(ws.Cells(r, "A").Value) Or IsError(ws.Cells(r, "B").Value) Or IsError(ws.Cells(r, "C").Value) Then
                statuses.Add CStr(r), "入力値要確認"
            Else
                car = Trim$(CStr(ws.Cells(r, "B").Value))
                If Not IsDate(ws.Cells(r, "A").Value) Or Len(car) = 0 Or Not PositiveAmount(ws.Cells(r, "C").Value, amount) Then
                    statuses.Add CStr(r), "入力値要確認"
                Else
                    result.Add Array(CStr(r), CDate(ws.Cells(r, "A").Value), car, amount)
                End If
            End If
        End If
    Next r
    Set ReadTickets = result
End Function

Private Function ReadLogs(ws As Worksheet, ByVal gasCol As Long) As Collection
    Dim answerCounts As Object, result As New Collection
    Dim r As Long, lastRow As Long, answer As String, car As String, amount As Double

    Set answerCounts = CreateObject("Scripting.Dictionary")
    lastRow = ws.Cells(ws.Rows.Count, "A").End(xlUp).Row
    For r = 2 To lastRow
        If Not IsError(ws.Cells(r, "A").Value) Then
            answer = Trim$(CStr(ws.Cells(r, "A").Value))
            If Len(answer) > 0 Then
                If answerCounts.Exists(answer) Then
                    answerCounts(answer) = CLng(answerCounts(answer)) + 1
                Else
                    answerCounts.Add answer, 1
                End If
            End If
        End If
    Next r

    For r = 2 To lastRow
        If Not IsError(ws.Cells(r, "A").Value) And Not IsError(ws.Cells(r, "J").Value) And Not IsError(ws.Cells(r, "K").Value) And Not IsError(ws.Cells(r, gasCol).Value) Then
            answer = Trim$(CStr(ws.Cells(r, "A").Value))
            car = Trim$(CStr(ws.Cells(r, "J").Value))
            If Len(answer) > 0 And Len(car) > 0 Then
                If IsDate(ws.Cells(r, "K").Value) And PositiveAmount(ws.Cells(r, gasCol).Value, amount) Then
                    If CLng(answerCounts(answer)) = 1 Then result.Add Array(answer, CDate(ws.Cells(r, "K").Value), car, amount)
                End If
            End If
        End If
    Next r
    Set ReadLogs = result
End Function

Private Sub ResolveStage(tickets As Collection, logs As Collection, usedTickets As Object, usedLogs As Object, matches As Object, reservedTickets As Object, reservedLogs As Object, ByVal sameDay As Boolean)
    Dim proposals As New Collection, ticket As Variant, logItem As Variant, ticketKey As String, answer As String
    Dim changed As Boolean, proposal As Variant

    Do
        Set proposals = New Collection
        For Each ticket In tickets
            ticketKey = CStr(ticket(0))
            If Not usedTickets.Exists(ticketKey) And (sameDay Or Not reservedTickets.Exists(ticketKey)) Then
                If TicketCandidateCount(ticket, logs, usedLogs, reservedLogs, sameDay) = 1 Then
                    logItem = OnlyTicketCandidate(ticket, logs, usedLogs, reservedLogs, sameDay)
                    answer = CStr(logItem(0))
                    If LogCandidateCount(logItem, tickets, usedTickets, reservedTickets, sameDay) = 1 Then proposals.Add Array(ticketKey, answer, CDate(logItem(1)))
                End If
            End If
        Next ticket

        changed = (proposals.Count > 0)
        For Each proposal In proposals
            ticketKey = CStr(proposal(0)): answer = CStr(proposal(1))
            If Not usedTickets.Exists(ticketKey) And Not usedLogs.Exists(answer) Then
                usedTickets.Add ticketKey, True
                usedLogs.Add answer, True
                matches.Add ticketKey, Array(answer, sameDay, CDate(proposal(2)))
            End If
        Next proposal
    Loop While changed
End Sub

Private Function TicketCandidateCount(ticket As Variant, logs As Collection, usedLogs As Object, reservedLogs As Object, ByVal sameDay As Boolean) As Long
    Dim logItem As Variant
    For Each logItem In logs
        If Not usedLogs.Exists(CStr(logItem(0))) And (sameDay Or Not reservedLogs.Exists(CStr(logItem(0)))) Then
            If IsCandidate(ticket, logItem, sameDay) Then TicketCandidateCount = TicketCandidateCount + 1
        End If
    Next logItem
End Function

Private Function OnlyTicketCandidate(ticket As Variant, logs As Collection, usedLogs As Object, reservedLogs As Object, ByVal sameDay As Boolean) As Variant
    Dim logItem As Variant
    For Each logItem In logs
        If Not usedLogs.Exists(CStr(logItem(0))) And (sameDay Or Not reservedLogs.Exists(CStr(logItem(0)))) Then
            If IsCandidate(ticket, logItem, sameDay) Then
                OnlyTicketCandidate = logItem
                Exit Function
            End If
        End If
    Next logItem
End Function

Private Function LogCandidateCount(logItem As Variant, tickets As Collection, usedTickets As Object, reservedTickets As Object, ByVal sameDay As Boolean) As Long
    Dim ticket As Variant
    For Each ticket In tickets
        If Not usedTickets.Exists(CStr(ticket(0))) And (sameDay Or Not reservedTickets.Exists(CStr(ticket(0)))) Then
            If IsCandidate(ticket, logItem, sameDay) Then LogCandidateCount = LogCandidateCount + 1
        End If
    Next ticket
End Function

Private Function IsCandidate(ticket As Variant, logItem As Variant, ByVal sameDay As Boolean) As Boolean
    If CStr(ticket(2)) <> CStr(logItem(2)) Then Exit Function
    If CDbl(ticket(3)) <> CDbl(logItem(3)) Then Exit Function
    If sameDay Then
        IsCandidate = (CDate(ticket(1)) = CDate(logItem(1)))
    Else
        IsCandidate = (CDate(logItem(1)) > CDate(ticket(1)))
    End If
End Function

Private Sub ReserveAmbiguousSameDay(tickets As Collection, logs As Collection, usedTickets As Object, usedLogs As Object, reservedTickets As Object, reservedLogs As Object)
    Dim ticket As Variant, logItem As Variant, ticketKey As String, answer As String
    For Each ticket In tickets
        ticketKey = CStr(ticket(0))
        If Not usedTickets.Exists(ticketKey) Then
            For Each logItem In logs
                answer = CStr(logItem(0))
                If Not usedLogs.Exists(answer) Then
                    If IsCandidate(ticket, logItem, True) Then
                        If Not reservedTickets.Exists(ticketKey) Then reservedTickets.Add ticketKey, True
                        If Not reservedLogs.Exists(answer) Then reservedLogs.Add answer, True
                    End If
                End If
            Next logItem
        End If
    Next ticket
End Sub

Private Sub SetRemainingStatuses(tickets As Collection, logs As Collection, statuses As Object, usedTickets As Object, usedLogs As Object, matches As Object, reservedTickets As Object, reservedLogs As Object)
    Dim ticket As Variant, ticketKey As String
    For Each ticket In tickets
        ticketKey = CStr(ticket(0))
        If Not matches.Exists(ticketKey) Then
            If reservedTickets.Exists(ticketKey) Then
                statuses.Add ticketKey, "候補複数・要確認"
            ElseIf TicketCandidateCount(ticket, logs, usedLogs, reservedLogs, False) > 0 Or TicketCandidateCount(ticket, logs, usedLogs, reservedLogs, True) > 0 Then
                statuses.Add ticketKey, "候補複数・要確認"
            Else
                statuses.Add ticketKey, "未照合"
            End If
        End If
    Next ticket
End Sub

Private Sub WriteTicketResults(ws As Worksheet, tickets As Collection, statuses As Object, matches As Object)
    Dim ticket As Variant, ticketKey As String, matchInfo As Variant, statusText As String
    Dim allRows As Object, key As Variant
    Set allRows = CreateObject("Scripting.Dictionary")
    For Each ticket In tickets
        allRows.Add CStr(ticket(0)), True
    Next ticket
    For Each key In statuses.Keys
        If Not allRows.Exists(CStr(key)) Then
            allRows.Add CStr(key), True
        End If
    Next key

    For Each key In allRows.Keys
        ticketKey = CStr(key)
        If matches.Exists(ticketKey) Then
            matchInfo = matches(ticketKey)
            statusText = IIf(CBool(matchInfo(1)), "同日一致", "後日一致")
        Else
            statusText = statuses(ticketKey)
        End If
        ws.Cells(CLng(ticketKey), "D").Value = statusText
        ws.Cells(CLng(ticketKey), "H").Value = FUEL_OUTPUT_MARKER
        If matches.Exists(ticketKey) Then
            ws.Cells(CLng(ticketKey), "E").Value = CDate(matchInfo(2))
            ws.Cells(CLng(ticketKey), "F").Value = CStr(matchInfo(0))
            ws.Cells(CLng(ticketKey), "G").Value = IIf(CBool(matchInfo(1)), "", "発行日後の給油")
        ElseIf statusText = "候補複数・要確認" Then
            ws.Cells(CLng(ticketKey), "G").Value = "同条件の候補が複数あります"
        ElseIf statusText = "入力値要確認" Then
            ws.Cells(CLng(ticketKey), "G").Value = "日付・車両番号・給油量を確認してください"
        End If
    Next key
End Sub

Private Function HeaderColumn(ws As Worksheet, text As String) As Long
