Private Function 記録シート整理を実行(ByVal 結果表示 As Boolean) As Long
    Dim ws As Worksheet, lastRow As Long, lastColumn As Long, validationFailures As Long
    Dim vehicleColumn As Long, dateColumn As Long, startTimeColumn As Long
    Dim startMeterColumn As Long, endMeterColumn As Long
    Dim i As Long, currentVehicle As String, previousVehicle As String
    Dim vehicleValue As Variant, previousMeter As Variant, oldEvents As Boolean, eventsCaptured As Boolean

    On Error GoTo OrganizerFailed
    Set ws = ThisWorkbook.Sheets("記録")
    lastRow = 記録最終行(ws)
    If lastRow < 3 Then
        If 結果表示 Then MsgBox "データが不足しています。", vbExclamation
        記録シート整理を実行 = 1
        Exit Function
    End If

    vehicleColumn = 記録列番号(ws, "車両番号")
    dateColumn = 記録列番号(ws, "運転した日")
    startTimeColumn = 記録列番号(ws, "使用時間（始）")
    startMeterColumn = 記録列番号(ws, "始業時メーター(km)")
    endMeterColumn = 記録列番号(ws, "終業時メーター(km)")
    lastColumn = 記録最終列(ws)
    If vehicleColumn = 0 Or dateColumn = 0 Or startTimeColumn = 0 Or _
       startMeterColumn = 0 Or endMeterColumn = 0 Then
        MsgBox "記録シートの並び替えまたはメーター補完に必要な見出しが見つかりません。", vbExclamation
        記録シート整理を実行 = 1
        Exit Function
    End If

    ' Q列（始業時メーター）補完より前に、終業メーターと日時で車両候補を確認する。
    Call 車両選択候補の事前チェック(ws, lastRow)

    oldEvents = Application.EnableEvents
    eventsCaptured = True
    Application.EnableEvents = False
    With ws.Sort
        .SortFields.Clear
        .SortFields.Add Key:=ws.Range(ws.Cells(2, vehicleColumn), ws.Cells(lastRow, vehicleColumn)), Order:=xlAscending
        .SortFields.Add Key:=ws.Range(ws.Cells(2, dateColumn), ws.Cells(lastRow, dateColumn)), Order:=xlAscending
        .SortFields.Add Key:=ws.Range(ws.Cells(2, startTimeColumn), ws.Cells(lastRow, startTimeColumn)), Order:=xlAscending
        .SetRange ws.Range(ws.Cells(2, 1), ws.Cells(lastRow, lastColumn))
        .Header = xlNo
        .Apply
    End With
    Application.EnableEvents = oldEvents

    previousVehicle = ""
    previousMeter = ""
    For i = 2 To lastRow
        vehicleValue = ws.Cells(i, vehicleColumn).Value
        If IsError(vehicleValue) Or IsEmpty(vehicleValue) Then
            currentVehicle = ""
        Else
            currentVehicle = Trim$(CStr(vehicleValue))
        End If

        If currentVehicle = previousVehicle And IsNumeric(previousMeter) Then
            If Not 記録行は確認済み(ws, i) Then ws.Cells(i, startMeterColumn).Value = previousMeter
        End If

        previousVehicle = currentVehicle
        If IsError(ws.Cells(i, endMeterColumn).Value) Then
            previousMeter = Empty
        Else
            previousMeter = ws.Cells(i, endMeterColumn).Value
        End If
    Next i

    validationFailures = 入力内容チェック実行(False)
    記録シート整理を実行 = validationFailures
    If 結果表示 Then MsgBox "並び替えと始業時メーターの補完が完了しました。", vbInformation
    Exit Function
OrganizerFailed:
    If eventsCaptured Then Application.EnableEvents = oldEvents
    記録シート整理を実行 = validationFailures + 1
    MsgBox "記録シート整理を中止しました。" & Err.Description, vbExclamation
    Err.Clear
End Function

Public Sub 給油記録を照合()
    Call 給油記録を照合実行(True)
End Sub

Private Function 給油記録を照合実行(ByVal 結果表示 As Boolean) As Boolean
    Dim ticketWS As Worksheet, logWS As Worksheet
    Dim tickets As Collection, logs As Collection
    Dim statuses As Object, matches As Object, usedTickets As Object, usedLogs As Object
    Dim reservedSameDayTickets As Object, reservedSameDayLogs As Object
    Dim gasCol As Long

    On Error GoTo Failed
    Set ticketWS = ThisWorkbook.Worksheets("給油記録")
    Set logWS = ThisWorkbook.Worksheets("記録")
    gasCol = HeaderColumn(logWS, GASOLINE_FUEL_HEADER)
    If gasCol = 0 Then
        MsgBox "記録シートのガソリン給油列が見つかりません。", vbExclamation
        Exit Function
    End If
    If Not PrepareTicketOutput(ticketWS) Then Exit Function

    Set statuses = CreateObject("Scripting.Dictionary")
    Set tickets = ReadTickets(ticketWS, statuses)
    Set logs = ReadLogs(logWS, gasCol)
    Set matches = CreateObject("Scripting.Dictionary")
    Set usedTickets = CreateObject("Scripting.Dictionary")
    Set usedLogs = CreateObject("Scripting.Dictionary")
    Set reservedSameDayTickets = CreateObject("Scripting.Dictionary")
    Set reservedSameDayLogs = CreateObject("Scripting.Dictionary")

    ResolveStage tickets, logs, usedTickets, usedLogs, matches, reservedSameDayTickets, reservedSameDayLogs, True
    ReserveAmbiguousSameDay tickets, logs, usedTickets, usedLogs, reservedSameDayTickets, reservedSameDayLogs
    ResolveStage tickets, logs, usedTickets, usedLogs, matches, reservedSameDayTickets, reservedSameDayLogs, False
    SetRemainingStatuses tickets, logs, statuses, usedTickets, usedLogs, matches, reservedSameDayTickets, reservedSameDayLogs
    If Not ResetManagedTicketOutput(ticketWS) Then Exit Function
    WriteTicketResults ticketWS, tickets, statuses, matches
    If Not 給油警告を記録シートへ反映(ticketWS, logWS, gasCol) Then Exit Function

    If 結果表示 Then MsgBox "給油記録の照合が完了しました。", vbInformation
    給油記録を照合実行 = True
    Exit Function
Failed:
    MsgBox "給油照合を中止しました。" & Err.Description, vbExclamation
End Function

Private Function 給油警告を記録シートへ反映(ByVal ticketWS As Worksheet, ByVal logWS As Worksheet, ByVal gasCol As Long) As Boolean
    Dim lastTicketRow As Long, lastLogRow As Long, rowNo As Long, ticketRow As Long
    Dim answerColumn As Long, vehicleColumn As Long, dateColumn As Long
    Dim ticketDate As Double, ticketAmount As Double, car As String
    Dim statusText As String, answer As String, warningText As String, dateText As String
    Dim rowsToWarn As Collection, unconfirmedRows As Collection
    Dim ticketItem As Variant, logItem As Variant, candidateLog As Variant
    Dim tickets As Collection, logs As Collection, ticketStatus As Object
    Dim usedAnswers As Object, reservedAnswers As Object
    Dim noteFailures As Long, unlocatedCount As Long, exactCandidateCount As Long

    On Error GoTo Failed
    answerColumn = 記録列番号(logWS, "回答番号")
    vehicleColumn = 記録列番号(logWS, "車両番号")
    dateColumn = 記録列番号(logWS, "運転した日")
    If answerColumn = 0 Or vehicleColumn = 0 Or dateColumn = 0 Or gasCol = 0 Then GoTo Failed
    lastLogRow = 記録最終行(logWS)
    Call セルの自動チェック警告カテゴリを除去(logWS.Cells(1, gasCol), noteFailures, "給油照合警告")
    For rowNo = 2 To lastLogRow
        If Not 記録行は確認済み(logWS, rowNo) Then
            Call セルの自動チェック警告カテゴリを除去(logWS.Cells(rowNo, gasCol), noteFailures, "給油照合警告")
        End If
    Next rowNo

    Set ticketStatus = CreateObject("Scripting.Dictionary")
    Set tickets = ReadTickets(ticketWS, ticketStatus)
    Set logs = ReadLogs(logWS, gasCol)
    Set usedAnswers = CreateObject("Scripting.Dictionary")
    Set reservedAnswers = CreateObject("Scripting.Dictionary")
    lastTicketRow = LastTicketInputRow(ticketWS)
    For ticketRow = 2 To lastTicketRow
        If Not IsError(ticketWS.Cells(ticketRow, "D").Value) Then
            statusText = Trim$(CStr(ticketWS.Cells(ticketRow, "D").Value))
            If (statusText = "同日一致" Or statusText = "後日一致") And Not IsError(ticketWS.Cells(ticketRow, "F").Value) Then
                answer = Trim$(CStr(ticketWS.Cells(ticketRow, "F").Value))
                If Len(answer) > 0 Then usedAnswers(answer) = True
            End If
        End If
    Next ticketRow
    For Each ticketItem In tickets
        If Trim$(CStr(ticketWS.Cells(CLng(ticketItem(0)), "D").Value)) = "候補複数・要確認" Then
            For Each logItem In logs
                If IsCandidate(ticketItem, logItem, True) Then
                    If Not usedAnswers.Exists(CStr(logItem(0))) Then reservedAnswers(CStr(logItem(0))) = True
                End If
            Next logItem
        End If
    Next ticketItem

    For ticketRow = 2 To lastTicketRow
        If Not IsError(ticketWS.Cells(ticketRow, "D").Value) Then
            statusText = Trim$(CStr(ticketWS.Cells(ticketRow, "D").Value))
            If statusText = "未照合" Then
                If Not IsError(ticketWS.Cells(ticketRow, "A").Value) And Not IsError(ticketWS.Cells(ticketRow, "B").Value) And _
                   Not IsError(ticketWS.Cells(ticketRow, "C").Value) Then
                    If IsDate(ticketWS.Cells(ticketRow, "A").Value) And _
                       PositiveAmount(ticketWS.Cells(ticketRow, "C").Value, ticketAmount) Then
                        car = Trim$(CStr(ticketWS.Cells(ticketRow, "B").Value))
                        ticketDate = Fix(CDbl(CDate(ticketWS.Cells(ticketRow, "A").Value)))
                        Set rowsToWarn = New Collection
                        For rowNo = 2 To lastLogRow
                            If Not IsError(logWS.Cells(rowNo, vehicleColumn).Value) And _
                               Not IsError(logWS.Cells(rowNo, dateColumn).Value) Then
                                If Trim$(CStr(logWS.Cells(rowNo, vehicleColumn).Value)) = car And _
                                   IsDate(logWS.Cells(rowNo, dateColumn).Value) Then
                                    If Fix(CDbl(CDate(logWS.Cells(rowNo, dateColumn).Value))) = ticketDate Then rowsToWarn.Add rowNo
                                End If
                            End If
                        Next rowNo

                        Set unconfirmedRows = New Collection
                        For Each ticketItem In rowsToWarn
                            If Not 記録行は確認済み(logWS, CLng(ticketItem)) Then unconfirmedRows.Add CLng(ticketItem)
                        Next ticketItem
                        If unconfirmedRows.Count = 0 Then
                            unlocatedCount = unlocatedCount + 1
                        Else
                            dateText = Format$(CDate(ticketDate), "m月d日")
                            If unconfirmedRows.Count = 1 Then
                                warningText = "要確認：給油記録に" & vbCrLf & dateText & "・" & car & "号車・" & _
                                              Format$(ticketAmount, "0.##") & "Lのチケットがありますが、" & vbCrLf & _
                                              "対応する給油入力が確認できません。" & vbCrLf & vbCrLf & _
                                              "チケット発行日と実際の給油日が異なる可能性も含めて確認してください。"
                            Else
                                warningText = "この日の給油チケットが未照合です。どの運転記録に対応するか確認してください。"
                            End If
                            For Each ticketItem In unconfirmedRows
                                Call 自動チェック警告を追加(logWS.Cells(CLng(ticketItem), gasCol), warningText, noteFailures, "給油照合警告")
                            Next ticketItem
                        End If
                    End If
                End If
            ElseIf statusText = "候補複数・要確認" Then
                For Each ticketItem In tickets
                    If CStr(ticketItem(0)) = CStr(ticketRow) Then
                        Set rowsToWarn = New Collection
                        exactCandidateCount = 0
                        ticketDate = Fix(CDbl(CDate(ticketItem(1))))
                        For Each logItem In logs
                            If IsCandidate(ticketItem, logItem, True) And Not usedAnswers.Exists(CStr(logItem(0))) Then
                                rowsToWarn.Add logItem
                                exactCandidateCount = exactCandidateCount + 1
                            End If
                        Next logItem
                        If exactCandidateCount = 0 Then
                            For Each logItem In logs
                                If IsCandidate(ticketItem, logItem, False) And Not usedAnswers.Exists(CStr(logItem(0))) And _
                                   Not reservedAnswers.Exists(CStr(logItem(0))) Then rowsToWarn.Add logItem
                            Next logItem
                        End If
                        Set unconfirmedRows = New Collection
                        For Each candidateLog In rowsToWarn
                            If Not 記録行は確認済み(logWS, CLng(candidateLog(4))) Then unconfirmedRows.Add candidateLog
                        Next candidateLog
                        If unconfirmedRows.Count = 0 Then
                            unlocatedCount = unlocatedCount + 1
                        Else
                            warningText = "要確認：この給油記録には複数の照合候補があります。" & vbCrLf & _
                                          "自動確定していません。給油記録シートを確認してください。"
                            For Each candidateLog In unconfirmedRows
                                Call 自動チェック警告を追加(logWS.Cells(CLng(candidateLog(4)), gasCol), _
                                    warningText, noteFailures, "給油照合警告")
                            Next candidateLog
                        End If
                        Exit For
                    End If
                Next ticketItem
            End If
        End If
    Next ticketRow

    If unlocatedCount > 0 Then
        warningText = "要確認：給油記録シートに、記録シート上で対応先を特定できない未照合チケットが" & _
                      CStr(unlocatedCount) & "件あります。詳細は給油記録シートD:Gを確認してください。"
        Call 自動チェック警告を追加(logWS.Cells(1, gasCol), warningText, noteFailures, "給油照合警告")
    End If
    If noteFailures > 0 Then
        MsgBox "給油照合警告の" & noteFailures & "セルでコメントまたは書式を処理できませんでした。確認してください。", vbExclamation
        Exit Function
    End If
    給油警告を記録シートへ反映 = True
    Exit Function
Failed:
    MsgBox "記録シートへの給油警告反映を中止しました。" & Err.Description, vbExclamation
    Err.Clear
End Function

Private Function PrepareTicketOutput(ws As Worksheet) As Boolean
    Dim r As Long, lastRow As Long, activeRow As Boolean, hasOutput As Boolean

    lastRow = LastTicketInputRow(ws)
    If Not HeadersAreSafe(ws) Then
        MsgBox "給油記録シートのD:H見出しに管理外の値があります。上書きしないため中止しました。", vbExclamation
        Exit Function
    End If

    For r = 2 To lastRow
        activeRow = TicketRowHasInput(ws, r)
        hasOutput = Application.WorksheetFunction.CountA(ws.Range("D" & r & ":H" & r)) > 0
        If activeRow And hasOutput And Trim$(CStr(ws.Cells(r, "H").Value)) <> FUEL_OUTPUT_MARKER Then
            MsgBox "給油記録の入力行に、このマクロ以外のD:H既存値があります。上書きしないため中止しました。", vbExclamation
            Exit Function
        End If
    Next r
    PrepareTicketOutput = True
End Function

Private Function ResetManagedTicketOutput(ws As Worksheet) As Boolean
    Dim r As Long, lastRow As Long
    lastRow = LastTicketSheetRow(ws)
    For r = 2 To lastRow
        If Not IsError(ws.Cells(r, "H").Value) Then
            If Trim$(CStr(ws.Cells(r, "H").Value)) = FUEL_OUTPUT_MARKER Then ws.Range("D" & r & ":H" & r).ClearContents
        End If
    Next r
    ws.Range("D1:H1").Value = Array("照合結果", "実給油日", "LoGo回答番号", "備考", "管理マーカー")
    ResetManagedTicketOutput = True
End Function

Private Function LastTicketSheetRow(ws As Worksheet) As Long
    Dim c As Long, candidate As Long
    For c = 1 To 8
        candidate = ws.Cells(ws.Rows.Count, c).End(xlUp).Row
        If candidate > LastTicketSheetRow Then LastTicketSheetRow = candidate
    Next c
End Function

Private Function HeadersAreSafe(ws As Worksheet) As Boolean
    Dim expected As Variant, c As Long, currentValue As String
    expected = Array("照合結果", "実給油日", "LoGo回答番号", "備考", "管理マーカー")
    For c = 0 To 4
        currentValue = Trim$(CStr(ws.Cells(1, "D").Offset(0, c).Value))
        If Len(currentValue) > 0 And currentValue <> expected(c) Then Exit Function
    Next c
    HeadersAreSafe = True
End Function

Private Function LastTicketInputRow(ws As Worksheet) As Long
    Dim c As Long, candidate As Long
    For c = 1 To 3
        candidate = ws.Cells(ws.Rows.Count, c).End(xlUp).Row
        If candidate > LastTicketInputRow Then LastTicketInputRow = candidate
    Next c
End Function

Private Function TicketRowHasInput(ws As Worksheet, ByVal rowNo As Long) As Boolean
    TicketRowHasInput = Application.WorksheetFunction.CountA(ws.Range("A" & rowNo & ":C" & rowNo)) > 0
End Function

Private Function ReadTickets(ws As Worksheet, statuses As Object) As Collection
    Dim result As New Collection, r As Long, lastRow As Long, amount As Double, car As String
    lastRow = LastTicketInputRow(ws)
    For r = 2 To lastRow
        If TicketRowHasInput(ws, r) Then
            If IsError(ws.Cells(r, "A").Value) Or IsError(ws.Cells(r, "B").Value) Or IsError(ws.Cells(r, "C").Value) Then
                statuses.Add CStr(r), "入力値要確認"
            Else
                car = Trim$(CStr(ws.Cells(r, "B").Value))
                If Not IsDate(ws.Cells(r, "A").Value) Or Len(car) = 0 Or Not PositiveAmount(ws.Cells(r, "C").Value, amount) Then
                    statuses.Add CStr(r), "入力値要確認"
                Else
                    result.Add Array(CStr(r), CDate(ws.Cells(r, "A").Value), car, amount)
                End If
            End If
        End If
    Next r
    Set ReadTickets = result
End Function

Private Function ReadLogs(ws As Worksheet, ByVal gasCol As Long) As Collection
    Dim answerCounts As Object, result As New Collection
    Dim answerColumn As Long, vehicleColumn As Long, dateColumn As Long
    Dim r As Long, lastRow As Long, answer As String, car As String, amount As Double

    answerColumn = 記録列番号(ws, "回答番号")
    vehicleColumn = 記録列番号(ws, "車両番号")
    dateColumn = 記録列番号(ws, "運転した日")
    If answerColumn = 0 Or vehicleColumn = 0 Or dateColumn = 0 Or gasCol = 0 Then
        Set ReadLogs = result
        Exit Function
    End If

    Set answerCounts = CreateObject("Scripting.Dictionary")
    lastRow = 記録最終行(ws)
    For r = 2 To lastRow
        If Not IsError(ws.Cells(r, answerColumn).Value) Then
            answer = Trim$(CStr(ws.Cells(r, answerColumn).Value))
            If Len(answer) > 0 Then
                If answerCounts.Exists(answer) Then
                    answerCounts(answer) = CLng(answerCounts(answer)) + 1
                Else
                    answerCounts.Add answer, 1
                End If
            End If
        End If
    Next r

    For r = 2 To lastRow
        If Not IsError(ws.Cells(r, answerColumn).Value) And _
           Not IsError(ws.Cells(r, vehicleColumn).Value) And _
           Not IsError(ws.Cells(r, dateColumn).Value) And _
           Not IsError(ws.Cells(r, gasCol).Value) Then
            answer = Trim$(CStr(ws.Cells(r, answerColumn).Value))
            car = Trim$(CStr(ws.Cells(r, vehicleColumn).Value))
            If Len(answer) > 0 And Len(car) > 0 Then
                If IsDate(ws.Cells(r, dateColumn).Value) And PositiveAmount(ws.Cells(r, gasCol).Value, amount) Then
                    If CLng(answerCounts(answer)) = 1 Then _
                        result.Add Array(answer, CDate(ws.Cells(r, dateColumn).Value), car, amount, r)
                End If
            End If
        End If
    Next r
    Set ReadLogs = result
End Function

Private Sub ResolveStage(tickets As Collection, logs As Collection, usedTickets As Object, usedLogs As Object, matches As Object, reservedTickets As Object, reservedLogs As Object, ByVal sameDay As Boolean)
    Dim proposals As New Collection, ticket As Variant, logItem As Variant, ticketKey As String, answer As String
    Dim changed As Boolean, proposal As Variant

    Do
        Set proposals = New Collection
        For Each ticket In tickets
            ticketKey = CStr(ticket(0))
            If Not usedTickets.Exists(ticketKey) And (sameDay Or Not reservedTickets.Exists(ticketKey)) Then
                If TicketCandidateCount(ticket, logs, usedLogs, reservedLogs, sameDay) = 1 Then
                    logItem = OnlyTicketCandidate(ticket, logs, usedLogs, reservedLogs, sameDay)
                    answer = CStr(logItem(0))
                    If LogCandidateCount(logItem, tickets, usedTickets, reservedTickets, sameDay) = 1 Then proposals.Add Array(ticketKey, answer, CDate(logItem(1)))
                End If
            End If
        Next ticket

        changed = (proposals.Count > 0)
        For Each proposal In proposals
            ticketKey = CStr(proposal(0)): answer = CStr(proposal(1))
            If Not usedTickets.Exists(ticketKey) And Not usedLogs.Exists(answer) Then
                usedTickets.Add ticketKey, True
                usedLogs.Add answer, True
                matches.Add ticketKey, Array(answer, sameDay, CDate(proposal(2)))
            End If
        Next proposal
    Loop While changed
End Sub

Private Function TicketCandidateCount(ticket As Variant, logs As Collection, usedLogs As Object, reservedLogs As Object, ByVal sameDay As Boolean) As Long
    Dim logItem As Variant
    For Each logItem In logs
        If Not usedLogs.Exists(CStr(logItem(0))) And (sameDay Or Not reservedLogs.Exists(CStr(logItem(0)))) Then
            If IsCandidate(ticket, logItem, sameDay) Then TicketCandidateCount = TicketCandidateCount + 1
        End If
    Next logItem
End Function

Private Function OnlyTicketCandidate(ticket As Variant, logs As Collection, usedLogs As Object, reservedLogs As Object, ByVal sameDay As Boolean) As Variant
    Dim logItem As Variant
    For Each logItem In logs
        If Not usedLogs.Exists(CStr(logItem(0))) And (sameDay Or Not reservedLogs.Exists(CStr(logItem(0)))) Then
            If IsCandidate(ticket, logItem, sameDay) Then
                OnlyTicketCandidate = logItem
                Exit Function
            End If
        End If
    Next logItem
End Function

Private Function LogCandidateCount(logItem As Variant, tickets As Collection, usedTickets As Object, reservedTickets As Object, ByVal sameDay As Boolean) As Long
    Dim ticket As Variant
    For Each ticket In tickets
        If Not usedTickets.Exists(CStr(ticket(0))) And (sameDay Or Not reservedTickets.Exists(CStr(ticket(0)))) Then
            If IsCandidate(ticket, logItem, sameDay) Then LogCandidateCount = LogCandidateCount + 1
        End If
    Next ticket
End Function

Private Function IsCandidate(ticket As Variant, logItem As Variant, ByVal sameDay As Boolean) As Boolean
    If CStr(ticket(2)) <> CStr(logItem(2)) Then Exit Function
    If CDbl(ticket(3)) <> CDbl(logItem(3)) Then Exit Function
    If sameDay Then
        IsCandidate = (CDate(ticket(1)) = CDate(logItem(1)))
    Else
        IsCandidate = (CDate(logItem(1)) > CDate(ticket(1)))
    End If
End Function

Private Sub ReserveAmbiguousSameDay(tickets As Collection, logs As Collection, usedTickets As Object, usedLogs As Object, reservedTickets As Object, reservedLogs As Object)
    Dim ticket As Variant, logItem As Variant, ticketKey As String, answer As String
    For Each ticket In tickets
        ticketKey = CStr(ticket(0))
        If Not usedTickets.Exists(ticketKey) Then
            For Each logItem In logs
                answer = CStr(logItem(0))
                If Not usedLogs.Exists(answer) Then
                    If IsCandidate(ticket, logItem, True) Then
                        If Not reservedTickets.Exists(ticketKey) Then reservedTickets.Add ticketKey, True
                        If Not reservedLogs.Exists(answer) Then reservedLogs.Add answer, True
                    End If
                End If
            Next logItem
        End If
    Next ticket
End Sub

Private Sub SetRemainingStatuses(tickets As Collection, logs As Collection, statuses As Object, usedTickets As Object, usedLogs As Object, matches As Object, reservedTickets As Object, reservedLogs As Object)
    Dim ticket As Variant, ticketKey As String
    For Each ticket In tickets
        ticketKey = CStr(ticket(0))
        If Not matches.Exists(ticketKey) Then
            If reservedTickets.Exists(ticketKey) Then
                statuses.Add ticketKey, "候補複数・要確認"
            ElseIf TicketCandidateCount(ticket, logs, usedLogs, reservedLogs, False) > 0 Or TicketCandidateCount(ticket, logs, usedLogs, reservedLogs, True) > 0 Then
                statuses.Add ticketKey, "候補複数・要確認"
            Else
                statuses.Add ticketKey, "未照合"
            End If
        End If
    Next ticket
End Sub

Private Sub WriteTicketResults(ws As Worksheet, tickets As Collection, statuses As Object, matches As Object)
    Dim ticket As Variant, ticketKey As String, matchInfo As Variant, statusText As String
    Dim allRows As Object, key As Variant
    Set allRows = CreateObject("Scripting.Dictionary")
    For Each ticket In tickets
        allRows.Add CStr(ticket(0)), True
    Next ticket
    For Each key In statuses.Keys
        If Not allRows.Exists(CStr(key)) Then
            allRows.Add CStr(key), True
        End If
    Next key

    For Each key In allRows.Keys
        ticketKey = CStr(key)
        If matches.Exists(ticketKey) Then
            matchInfo = matches(ticketKey)
            statusText = IIf(CBool(matchInfo(1)), "同日一致", "後日一致")
        Else
            statusText = statuses(ticketKey)
        End If
        ws.Cells(CLng(ticketKey), "D").Value = statusText
        ws.Cells(CLng(ticketKey), "H").Value = FUEL_OUTPUT_MARKER
        If matches.Exists(ticketKey) Then
            ws.Cells(CLng(ticketKey), "E").Value = CDate(matchInfo(2))
            ws.Cells(CLng(ticketKey), "F").Value = CStr(matchInfo(0))
            ws.Cells(CLng(ticketKey), "G").Value = IIf(CBool(matchInfo(1)), "", "発行日後の給油")
        ElseIf statusText = "候補複数・要確認" Then
            ws.Cells(CLng(ticketKey), "G").Value = "同条件の候補が複数あります"
        ElseIf statusText = "入力値要確認" Then
            ws.Cells(CLng(ticketKey), "G").Value = "日付・車両番号・給油量を確認してください"
        End If
    Next key
End Sub

Public Function 記録列番号(ByVal ws As Worksheet, ByVal text As String) As Long
    記録列番号 = HeaderColumn(ws, text)
End Function

Public Function 記録最終列(ByVal ws As Worksheet) As Long
    Dim headerBound As Long
    headerBound = ws.Cells(1, ws.Columns.Count).End(xlToLeft).Column
    If headerBound >= 1 Then 記録最終列 = headerBound
End Function

Public Function 記録最終行(ByVal ws As Worksheet) As Long
    Dim answerColumn As Long, lastColumn As Long, columnNo As Long, candidateRow As Long
    answerColumn = HeaderColumn(ws, "回答番号")
    If answerColumn = 0 Then Exit Function
    lastColumn = 記録最終列(ws)
    For columnNo = 2 To lastColumn
        candidateRow = ws.Cells(ws.Rows.Count, columnNo).End(xlUp).Row
        If candidateRow > 記録最終行 Then 記録最終行 = candidateRow
    Next columnNo
    If 記録最終行 < 2 Then 記録最終行 = 1
End Function

Public Function 確認チェックマーク() As String
    確認チェックマーク = ChrW(&H2713)
End Function

Public Function 記録行に回答番号あり(ByVal ws As Worksheet, ByVal rowNo As Long) As Boolean
    Dim answerColumn As Long
    answerColumn = 記録列番号(ws, "回答番号")
    If answerColumn = 0 Or rowNo < 2 Then Exit Function
    記録行に回答番号あり = (Len(回答番号をキー化(ws.Cells(rowNo, answerColumn).Value)) > 0)
End Function

Public Function 記録行は確認済み(ByVal ws As Worksheet, ByVal rowNo As Long) As Boolean
    Dim checkColumn As Long, checkValue As Variant
    checkColumn = 記録列番号(ws, "チェック")
    If rowNo < 2 Then Exit Function
    If checkColumn = 0 Then
        ' チェック列が欠落または重複し状態を特定できない場合は、マクロの書換えを禁止する。
        記録行は確認済み = True
        Exit Function
    End If
    checkValue = ws.Cells(rowNo, checkColumn).Value
    If IsError(checkValue) Or IsEmpty(checkValue) Then Exit Function
    記録行は確認済み = (CStr(checkValue) = 確認チェックマーク())
End Function

Public Function 未解決自動警告(ByVal ws As Worksheet, ByVal rowNo As Long, _
                              ByRef warningNames As String, ByRef firstWarningCell As Range) As Boolean
    Dim checkColumn As Long, answerColumn As Long, lastColumn As Long, columnNo As Long
    Dim target As Range, note As Comment, noteText As String, headerValue As Variant
    Dim hasWarning As Boolean, warningSet As Object, colorValue As Variant

    On Error GoTo WarningReadFailed
    Set firstWarningCell = Nothing
    warningNames = ""
    answerColumn = HeaderColumn(ws, "回答番号")
    checkColumn = HeaderColumn(ws, "チェック")
    lastColumn = 記録最終列(ws)
    If answerColumn = 0 Or checkColumn = 0 Or rowNo < 2 Then Exit Function

    Set warningSet = CreateObject("Scripting.Dictionary")
    warningSet.CompareMode = vbTextCompare
    For columnNo = 2 To lastColumn
        If columnNo <> checkColumn Then
            Set target = ws.Cells(rowNo, columnNo)
            Set note = target.Comment
            If Not note Is Nothing Then
                noteText = note.Text
                If InStr(1, noteText, CHECK_WARNING_START, vbBinaryCompare) > 0 Then
                    If InStr(1, noteText, CHECK_WARNING_END, vbBinaryCompare) = 0 Then
                        ' 不完全な自動管理コメントも、赤字が残る場合は安全側で未解決とする。
                    End If
                    colorValue = target.Font.Color
                    If IsNull(colorValue) Or IsError(colorValue) Then
                        hasWarning = True
                    Else
                        hasWarning = (CLng(colorValue) = vbRed)
                    End If
                    If hasWarning Then
                        If firstWarningCell Is Nothing Then Set firstWarningCell = target
                        headerValue = ws.Cells(1, columnNo).Value
                        If IsError(headerValue) Or Len(Trim$(CStr(headerValue))) = 0 Then
                            warningSet("列" & CStr(columnNo)) = True
                        Else
                            warningSet(Trim$(CStr(headerValue))) = True
                        End If
                    End If
                End If
            End If
        End If
    Next columnNo
    If warningSet.Count > 0 Then
        warningNames = Join(warningSet.Keys, "、")
        未解決自動警告 = True
    End If
    Exit Function
WarningReadFailed:
    warningNames = "自動警告情報"
    If firstWarningCell Is Nothing Then Set firstWarningCell = ws.Cells(rowNo, answerColumn)
    未解決自動警告 = True
    Err.Clear
End Function

Public Function 記録行は確認可能(ByVal ws As Worksheet, ByVal rowNo As Long, _
                              ByRef reasonText As String, ByRef firstWarningCell As Range) As Boolean
    Dim answerColumn As Long, warningNames As String, answerValue As Variant
    reasonText = ""
    Set firstWarningCell = Nothing
    answerColumn = HeaderColumn(ws, "回答番号")
    If answerColumn = 0 Then
        reasonText = "回答番号の見出しを確認してください。"
        Exit Function
    End If
    answerValue = ws.Cells(rowNo, answerColumn).Value
    If Not 記録行に回答番号あり(ws, rowNo) Then
        reasonText = "この行に有効な回答番号がありません。"
        Exit Function
    End If
    If 回答番号行を検索(ws, 回答番号をキー化(answerValue)) <> rowNo Then
        reasonText = "回答番号が重複しているため、一意に確認できません。"
        Exit Function
    End If
    If 未解決自動警告(ws, rowNo, warningNames, firstWarningCell) Then
        reasonText = "この記録には未確認の警告が残っています。" & vbCrLf & "・" & Replace(warningNames, "、", vbCrLf & "・")
        Exit Function
    End If
    記録行は確認可能 = True
End Function

Public Sub 未確認行を自動確定(ByVal ws As Worksheet, ByRef confirmedCount As Long, _
                            ByRef reviewCount As Long, ByVal allowAutoConfirmation As Boolean)
    Dim answerColumn As Long, checkColumn As Long, lastRow As Long, rowNo As Long
    Dim answerValue As Variant, checkValue As Variant, reasonText As String, firstWarningCell As Range
    Dim oldEvents As Boolean, eventsCaptured As Boolean

    On Error GoTo ConfirmFailed
    confirmedCount = 0
    reviewCount = 0
    answerColumn = HeaderColumn(ws, "回答番号")
    checkColumn = HeaderColumn(ws, "チェック")
    lastRow = 記録最終行(ws)
    If answerColumn = 0 Then
        If lastRow > 1 Then reviewCount = lastRow - 1
        Exit Sub
    End If
    If checkColumn = 0 Then
        For rowNo = 2 To lastRow
            If Len(回答番号をキー化(ws.Cells(rowNo, answerColumn).Value)) > 0 Then reviewCount = reviewCount + 1
        Next rowNo
        Exit Sub
    End If

    For rowNo = 2 To lastRow
        answerValue = ws.Cells(rowNo, answerColumn).Value
        If Len(回答番号をキー化(answerValue)) > 0 Then
            If Not 記録行は確認済み(ws, rowNo) Then
                If 回答番号行を検索(ws, 回答番号をキー化(answerValue)) <> rowNo Then
                    reviewCount = reviewCount + 1
                Else
                    checkValue = ws.Cells(rowNo, checkColumn).Value
                    If セルに値がある(checkValue) Then
                        reviewCount = reviewCount + 1
                    ElseIf allowAutoConfirmation And 記録行は確認可能(ws, rowNo, reasonText, firstWarningCell) Then
                        oldEvents = Application.EnableEvents
                        eventsCaptured = True
                        Application.EnableEvents = False
                        ws.Cells(rowNo, checkColumn).Value = 確認チェックマーク()
                        ws.Cells(rowNo, checkColumn).HorizontalAlignment = xlCenter
                        Application.EnableEvents = oldEvents
                        eventsCaptured = False
                        confirmedCount = confirmedCount + 1
                    Else
                        reviewCount = reviewCount + 1
                    End If
                End If
            End If
        End If
    Next rowNo
    Exit Sub
ConfirmFailed:
    If eventsCaptured Then Application.EnableEvents = oldEvents
    reviewCount = reviewCount + 1
    MsgBox "確認済みチェックを安全に更新できませんでした。" & Err.Description, vbExclamation
    Err.Clear
End Sub

Private Function HeaderColumn(ByVal ws As Worksheet, ByVal text As String) As Long
    Dim columnNo As Long, lastColumn As Long, headerValue As Variant, foundColumn As Long
    lastColumn = 記録最終列(ws)
    For columnNo = 1 To lastColumn
        headerValue = ws.Cells(1, columnNo).Value
        If Not IsError(headerValue) And Not IsEmpty(headerValue) Then
            If HeaderNameKey(CStr(headerValue)) = HeaderNameKey(text) Then
                If foundColumn > 0 Then
                    HeaderColumn = 0
                    Exit Function
                End If
                foundColumn = columnNo
            End If
        End If
    Next columnNo
    HeaderColumn = foundColumn
End Function

Private Function HeaderNameKey(ByVal text As String) As String
    text = Replace(Replace(Replace(Replace(text, vbCr, ""), vbLf, ""), vbTab, ""), " ", "")
    HeaderNameKey = Replace(text, "　", "")
End Function

Private Function HeaderColumnContaining(ByVal ws As Worksheet, ByVal text As String) As Long
    Dim columnNo As Long, lastColumn As Long, headerValue As Variant, foundColumn As Long
    lastColumn = 記録最終列(ws)
    For columnNo = 1 To lastColumn
        headerValue = ws.Cells(1, columnNo).Value
        If Not IsError(headerValue) And Not IsEmpty(headerValue) Then
            If InStr(1, CStr(headerValue), text, vbTextCompare) > 0 Then
                If foundColumn > 0 Then
                    HeaderColumnContaining = 0
                    Exit Function
                End If
                foundColumn = columnNo
            End If
        End If
    Next columnNo
    HeaderColumnContaining = foundColumn
End Function

Private Function PositiveAmount(v As Variant, ByRef n As Double) As Boolean
    If IsError(v) Or Not IsNumeric(v) Then Exit Function
    n = CDbl(v): PositiveAmount = (n > 0#)
End Function

Sub 転記to印刷様式()
    Dim wsSrc As Worksheet, wsDest As Worksheet
    Dim answerColumn As Long, vehicleColumn As Long, dateColumn As Long
    Dim weatherColumn As Long, conditionColumn As Long, startTimeColumn As Long, endTimeColumn As Long
    Dim destinationColumn As Long, startMeterColumn As Long, endMeterColumn As Long
    Dim dutyColumn As Long, passengerColumn As Long, driverColumn As Long
    Dim gasolineColumn As Long, dieselColumn As Long, oilColumn As Long, fuelLevelColumn As Long
    Dim beforeCheckerColumn As Long, beforeOtherColumn As Long, beforeMethodColumn As Long
    Dim beforePresenceColumn As Long, beforeValueColumn As Long
    Dim afterCheckerColumn As Long, afterOtherColumn As Long, afterMethodColumn As Long
    Dim afterPresenceColumn As Long, afterValueColumn As Long, specialColumn As Long
    Dim carNo As String, ansStart As Long, ansEnd As Long, i As Long, destTopRow As Long
    Dim fuelShapeIndex As Long, fuelLevel As Long, fuelCell As Range, halfFuelShape As Shape
    Dim fuelGaugeShape As Shape
    Dim fuelShapeLeft As Double, fuelShapeTop As Double
    Dim rowCount As Long, lastRow As Long

    Set wsSrc = ThisWorkbook.Sheets("記録")
    Set wsDest = ThisWorkbook.Sheets("印刷様式")
    answerColumn = 記録列番号(wsSrc, "回答番号")
    vehicleColumn = 記録列番号(wsSrc, "車両番号")
    dateColumn = 記録列番号(wsSrc, "運転した日")
    weatherColumn = 記録列番号(wsSrc, "天気")
    conditionColumn = 記録列番号(wsSrc, "自動車の状況")
    startTimeColumn = 記録列番号(wsSrc, "使用時間（始）")
    endTimeColumn = 記録列番号(wsSrc, "使用時間（終）")
    destinationColumn = 記録列番号(wsSrc, "行先")
    startMeterColumn = 記録列番号(wsSrc, "始業時メーター(km)")
    endMeterColumn = 記録列番号(wsSrc, "終業時メーター(km)")
    dutyColumn = 記録列番号(wsSrc, "用務")
    passengerColumn = 記録列番号(wsSrc, "乗車人数")
    driverColumn = 記録列番号(wsSrc, "運転者氏名")
    gasolineColumn = 記録列番号(wsSrc, GASOLINE_FUEL_HEADER)
    dieselColumn = HeaderColumnContaining(wsSrc, "軽油給油の有無")
    oilColumn = HeaderColumnContaining(wsSrc, "オイル給油の有無")
    fuelLevelColumn = HeaderColumnContaining(wsSrc, "燃料残量")
    beforeCheckerColumn = HeaderColumnContaining(wsSrc, "確認者（運転前）")
    beforeOtherColumn = 記録列番号(wsSrc, "確認者運転前（その他）")
    beforeMethodColumn = 記録列番号(wsSrc, "確認方法（運転前）")
    beforePresenceColumn = 記録列番号(wsSrc, "酒気帯びの有無（運転前）")
    beforeValueColumn = 記録列番号(wsSrc, "アルコール検知器の数値（運転前）")
    afterCheckerColumn = HeaderColumnContaining(wsSrc, "確認者（運転後）")
    afterOtherColumn = 記録列番号(wsSrc, "確認者運転後（その他）")
    afterMethodColumn = 記録列番号(wsSrc, "確認方法（運転後）")
    afterPresenceColumn = 記録列番号(wsSrc, "酒気帯びの有無（運転後）")
    afterValueColumn = 記録列番号(wsSrc, "アルコール検知器の数値（運転後）")
    specialColumn = 記録列番号(wsSrc, "特記事項")

    If answerColumn = 0 Or vehicleColumn = 0 Or dateColumn = 0 Or weatherColumn = 0 Or _
       conditionColumn = 0 Or startTimeColumn = 0 Or endTimeColumn = 0 Or destinationColumn = 0 Or _
       startMeterColumn = 0 Or endMeterColumn = 0 Or dutyColumn = 0 Or passengerColumn = 0 Or _
       driverColumn = 0 Or gasolineColumn = 0 Or dieselColumn = 0 Or oilColumn = 0 Or _
       fuelLevelColumn = 0 Or beforeCheckerColumn = 0 Or beforeOtherColumn = 0 Or _
       beforeMethodColumn = 0 Or beforePresenceColumn = 0 Or beforeValueColumn = 0 Or _
       afterCheckerColumn = 0 Or afterOtherColumn = 0 Or afterMethodColumn = 0 Or _
       afterPresenceColumn = 0 Or afterValueColumn = 0 Or specialColumn = 0 Then
        MsgBox "記録シートの転記に必要な見出しが見つからないため中止しました。", vbExclamation
        Exit Sub
    End If

    carNo = CStr(wsDest.Range("N2").Value)
    ansStart = wsDest.Range("O2").Value
    ansEnd = wsDest.Range("P2").Value
    If carNo = "" Or ansStart = 0 Or ansEnd = 0 Then
        MsgBox "N2～P2に車両番号・開始回答番号・終了回答番号を入力してください。", vbExclamation
        Exit Sub
    End If

    For fuelShapeIndex = wsDest.Shapes.Count To 1 Step -1
        If Left(wsDest.Shapes(fuelShapeIndex).Name, Len("FuelRemainHalf_")) = "FuelRemainHalf_" Then
            wsDest.Shapes(fuelShapeIndex).Delete
        End If
    Next fuelShapeIndex

    lastRow = 記録最終行(wsSrc)
    For i = 2 To lastRow
        If wsSrc.Cells(i, vehicleColumn).Value = carNo Then
            If wsSrc.Cells(i, answerColumn).Value >= ansStart And wsSrc.Cells(i, answerColumn).Value <= ansEnd Then
                destTopRow = 3 + rowCount * 22
                With wsDest
                    .Range("A" & destTopRow).Value = wsSrc.Cells(i, dateColumn).Value
                    .Range("D" & destTopRow).Value = wsSrc.Cells(i, weatherColumn).Value
                    .Range("G" & destTopRow).Value = wsSrc.Cells(i, conditionColumn).Value
                    .Range("J" & destTopRow).Value = wsSrc.Cells(i, vehicleColumn).Value
                    .Range("B" & (destTopRow + 2)).Value = wsSrc.Cells(i, startTimeColumn).Value
                    .Range("B" & (destTopRow + 3)).Value = wsSrc.Cells(i, endTimeColumn).Value
                    .Range("D" & (destTopRow + 2)).Value = wsSrc.Cells(i, destinationColumn).Value
                    .Range("D" & (destTopRow + 3)).Value = wsSrc.Cells(i, startMeterColumn).Value
                    .Range("D" & (destTopRow + 4)).Value = wsSrc.Cells(i, endMeterColumn).Value
                    .Range("E" & (destTopRow + 2)).Value = wsSrc.Cells(i, dutyColumn).Value
                    .Range("G" & (destTopRow + 3)).Value = wsSrc.Cells(i, passengerColumn).Value
                    .Range("H" & (destTopRow + 3)).Value = wsSrc.Cells(i, driverColumn).Value
                    .Range("K" & (destTopRow + 2)).Value = wsSrc.Cells(i, gasolineColumn).Value
                    .Range("K" & (destTopRow + 3)).Value = wsSrc.Cells(i, dieselColumn).Value
                    .Range("K" & (destTopRow + 4)).Value = wsSrc.Cells(i, oilColumn).Value

                    fuelLevel = Val(Trim$(CStr(wsSrc.Cells(i, fuelLevelColumn).Value)))
                    Set fuelCell = .Range("L" & (destTopRow + 3))
                    If fuelLevel = 1 Then
                        fuelCell.ClearContents
                        fuelShapeLeft = 燃料残量表示開始位置(fuelCell)
                        fuelShapeTop = fuelCell.MergeArea.Top + (fuelCell.MergeArea.Height - fuelCell.Font.Size) / 2
                        Set fuelGaugeShape = 燃料残量表示グループ(fuelCell)
                        If Not fuelGaugeShape Is Nothing Then
                            fuelShapeLeft = fuelGaugeShape.Left
                            fuelShapeTop = fuelGaugeShape.Top
                        End If
                        Set halfFuelShape = .Shapes.AddShape( _
                            msoShapeRectangle, _
                            fuelShapeLeft, _
                            fuelShapeTop, _
                            fuelCell.Font.Size / 2, _
                            fuelCell.Font.Size)
                        With halfFuelShape
                            .Name = "FuelRemainHalf_" & CStr(fuelCell.Row)
                            .Placement = xlMoveAndSize
                            .Fill.Visible = msoTrue
                            .Fill.Solid
                            .Fill.ForeColor.RGB = RGB(0, 0, 0)
                            .Line.Visible = msoFalse
                        End With
                    ElseIf fuelLevel >= 2 And fuelLevel <= 5 Then
                        fuelCell.Value = String(fuelLevel - 1, "■")
                    Else
                        fuelCell.Value = ""
                    End If

                    Call 転記_確認者チェック(wsSrc, wsDest, i, destTopRow + 6, _
                        beforeCheckerColumn, beforeOtherColumn, beforeMethodColumn, beforePresenceColumn, beforeValueColumn)
                    Call 転記_確認者チェック(wsSrc, wsDest, i, destTopRow + 12, _
                        afterCheckerColumn, afterOtherColumn, afterMethodColumn, afterPresenceColumn, afterValueColumn)
                    .Range("B" & (destTopRow + 18)).Value = wsSrc.Cells(i, specialColumn).Value
                End With
                rowCount = rowCount + 1
            End If
        End If
    Next i

    MsgBox rowCount & " 件のデータを印刷様式に転記しました。", vbInformation
End Sub

Private Function 燃料残量表示グループ(ByVal targetCell As Range) As Shape
    Dim existingShape As Shape
    For Each existingShape In targetCell.Worksheet.Shapes
        If existingShape.Type = msoGroup Then
            If existingShape.TopLeftCell.Row = targetCell.Row And _
               existingShape.TopLeftCell.Column = targetCell.Column Then
                Set 燃料残量表示グループ = existingShape
                Exit Function
            End If
        End If
    Next existingShape
End Function

Private Function 燃料残量表示開始位置(ByVal targetCell As Range) As Double
    Dim fuelDisplayArea As Range
    Dim glyphSize As Double
    Dim alignment As Variant
    Set fuelDisplayArea = targetCell.MergeArea
    glyphSize = targetCell.Font.Size
    alignment = targetCell.HorizontalAlignment
    If IsNull(alignment) Then alignment = xlHAlignLeft

    Select Case alignment
        Case xlHAlignCenter
            燃料残量表示開始位置 = fuelDisplayArea.Left + (fuelDisplayArea.Width - glyphSize) / 2
        Case xlHAlignRight
            燃料残量表示開始位置 = fuelDisplayArea.Left + fuelDisplayArea.Width - glyphSize - _
                                      targetCell.IndentLevel * glyphSize
        Case Else
            ' Text/General and left alignment: anchor at this report's own fuel cell.
            燃料残量表示開始位置 = fuelDisplayArea.Left + targetCell.IndentLevel * glyphSize
    End Select
End Function

Sub 転記_確認者チェック(wsSrc As Worksheet, wsDest As Worksheet, rowSrc As Long, baseRow As Long, _
                          col確認者 As Long, colその他 As Long, col方法 As Long, col有無 As Long, col数値 As Long)

    Dim val確認者 As String: val確認者 = wsSrc.Cells(rowSrc, col確認者).Value
    Dim val方法 As String: val方法 = wsSrc.Cells(rowSrc, col方法).Value
    Dim val有無 As String: val有無 = wsSrc.Cells(rowSrc, col有無).Value

    ' --- 確認者チェック（E列） ---
    wsDest.Cells(baseRow, "E").Value = IIf(val確認者 = "運転者本人", "■", "□")
    wsDest.Cells(baseRow + 1, "E").Value = IIf(val確認者 = "副運行管理者", "■", "□")
    wsDest.Cells(baseRow + 2, "E").Value = IIf(val確認者 = "運行管理者", "■", "□")
    
    ' ここがポイント！
    If val確認者 = "その他" Or val確認者 = "" Then
        wsDest.Cells(baseRow + 3, "E").Value = "■"
        wsDest.Cells(baseRow + 4, "F").Value = wsSrc.Cells(rowSrc, colその他).Value
    Else
        wsDest.Cells(baseRow + 3, "E").Value = "□"
        wsDest.Cells(baseRow + 4, "F").MergeArea.ClearContents
    End If


    ' --- F列への処理（その他 or 確認者が空白なら備考等を出力） ---
    If val確認者 = "その他" Or val確認者 = "" Then
        wsDest.Cells(baseRow + 4, "F").Value = wsSrc.Cells(rowSrc, colその他).Value
    Else
        wsDest.Cells(baseRow + 4, "F").MergeArea.ClearContents
    End If

    ' --- 確認方法（H列） ---
    wsDest.Cells(baseRow, "H").Value = IIf(val方法 = "対面", "■", "□")
    wsDest.Cells(baseRow + 1, "H").Value = IIf(val方法 <> "対面", "■", "□")

    ' --- 酒気帯びの有無（J列） ---
    wsDest.Cells(baseRow, "J").Value = IIf(val有無 = "有", "■", "□")
    wsDest.Cells(baseRow + 1, "J").Value = IIf(val有無 = "無", "■", "□")

    ' --- アルコール検知器の数値（K列） ---
    wsDest.Cells(baseRow + 4, "K").Value = wsSrc.Cells(rowSrc, col数値).Value

End Sub
Sub 一括消去()

    Dim ws As Worksheet
    Set ws = ThisWorkbook.Sheets("印刷様式")

    Dim i As Integer
    Dim blockStartRow As Long
    Dim blockHeight As Long: blockHeight = 22 ' 1ブロック21行＋1行空け
    Dim maxRow As Long
    Dim maxBlocks As Integer

    maxRow = ws.UsedRange.Rows(ws.UsedRange.Rows.Count).Row
    maxBlocks = Int((maxRow - 3) / blockHeight) + 1

    Dim r As Range

    For i = 0 To maxBlocks - 1
        blockStartRow = 3 + i * blockHeight

        With ws
            ' --- ヘッダー部 ---
            For Each r In .Range("A" & blockStartRow & ":A" & blockStartRow)
                r.MergeArea.ClearContents
            Next r
            For Each r In .Range("D" & blockStartRow & ":D" & blockStartRow)
                r.MergeArea.ClearContents
            Next r
            For Each r In .Range("G" & blockStartRow & ":G" & blockStartRow)
                r.MergeArea.ClearContents
            Next r
            For Each r In .Range("J" & blockStartRow & ":J" & blockStartRow)
                r.MergeArea.ClearContents
            Next r

            ' --- 基本情報 ---
            For Each r In .Range("B" & (blockStartRow + 2) & ":B" & (blockStartRow + 3))
                r.MergeArea.ClearContents
            Next r
            For Each r In .Range("D" & (blockStartRow + 2) & ":D" & (blockStartRow + 4))
                r.MergeArea.ClearContents
            Next r
            For Each r In .Range("E" & (blockStartRow + 2) & ":E" & (blockStartRow + 2))
                r.MergeArea.ClearContents
            Next r
            For Each r In .Range("G" & (blockStartRow + 3) & ":G" & (blockStartRow + 3))
                r.MergeArea.ClearContents
            Next r
            For Each r In .Range("H" & (blockStartRow + 3) & ":H" & (blockStartRow + 3))
                r.MergeArea.ClearContents
            Next r

            ' --- 給油情報 ---
            For Each r In .Range("K" & (blockStartRow + 2) & ":K" & (blockStartRow + 4))
                r.MergeArea.ClearContents
            Next r

            ' --- 燃料残量 ---
            For Each r In .Range("L" & (blockStartRow + 3) & ":L" & (blockStartRow + 3))
                r.MergeArea.ClearContents
            Next r

            ' --- 酒気帯び確認（運転前） ---
            For Each r In .Range("E" & (blockStartRow + 6) & ":E" & (blockStartRow + 9))
