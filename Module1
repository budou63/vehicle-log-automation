Private Const CHECK_LONG_DISTANCE_KM As Double = 100#
Private Const CHECK_LONG_USAGE_HOURS As Double = 8#
Private Const CHECK_ODO_TOLERANCE_KM As Double = 2#
Private Const CHECK_VEHICLE_SELECTION_ODO_TOLERANCE_KM As Double = 2#
Private Const CHECK_WARNING_START As String = "【自動入力チェック開始|"
Private Const CHECK_WARNING_END As String = "【自動入力チェック終了】"

Sub 運行記録メニューを開く()
    UserForm1.Show vbModeless  ' モードレス表示
