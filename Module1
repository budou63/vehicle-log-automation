        End If
    Next columnNo
End Function

Private Sub ガソリン給油量をチェック(ByVal target As Range, ByRef errorCount As Long)
    Dim amount As Double, noFuel As Boolean, nonPositive As Boolean, warningText As String
    If ガソリン給油量を解析(target.Value, amount, noFuel, nonPositive) Then
        target.Value = amount
    ElseIf Not noFuel Then
        If nonPositive Then
            warningText = "要確認：ガソリン給油量が0以下です。" & vbCrLf & vbCrLf & _
                          "入力値：" & セル値を表示(target.Value) & vbCrLf & vbCrLf & _
                          "給油量を確認してください。"
        Else
            warningText = "要確認：ガソリン給油量を数値として認識できません。" & vbCrLf & vbCrLf & _
                          "入力値：" & セル値を表示(target.Value) & vbCrLf & vbCrLf & _
                          "数値のみ、または「25L」のような形式で入力してください。" & vbCrLf & _
                          "入力内容を確認してください。"
        End If
        Call 自動チェック警告を追加(target, warningText, errorCount)
    End If
End Sub

Private Function ガソリン給油量を解析(ByVal cellValue As Variant, ByRef amount As Double, _
                                    ByRef noFuel As Boolean, ByRef nonPositive As Boolean) As Boolean
    Dim normalizedValue As String, numericText As String
    On Error GoTo InvalidFuelAmount
    If IsError(cellValue) Or IsEmpty(cellValue) Then
        noFuel = True
        Exit Function
    End If
    If VarType(cellValue) = vbBoolean Then Exit Function

    normalizedValue = Trim$(半角へ正規化(CStr(cellValue)))
    If Len(normalizedValue) = 0 Or normalizedValue = "なし" Then
        noFuel = True
        Exit Function
    End If

    numericText = normalizedValue
    If Right$(numericText, Len("リットル")) = "リットル" Then
        numericText = Trim$(Left$(numericText, Len(numericText) - Len("リットル")))
    ElseIf Right$(numericText, 1) = "L" Or Right$(numericText, 1) = "l" Or Right$(numericText, 1) = "ℓ" Then
        numericText = Trim$(Left$(numericText, Len(numericText) - 1))
    End If
    If Not 十進数を取得(numericText, amount) Then Exit Function
    If amount <= 0# Then
        nonPositive = True
        Exit Function
    End If
    ガソリン給油量を解析 = True
    Exit Function
InvalidFuelAmount:
    Err.Clear
End Function

Private Function 十進数を取得(ByVal numericText As String, ByRef amount As Double) As Boolean
    Dim position As Long, characterValue As String, digitValue As Long
    Dim negative As Boolean, decimalFound As Boolean, digitFound As Boolean
    Dim integerPart As Double, fractionPart As Double, divisor As Double

    If Len(numericText) = 0 Then Exit Function
    position = 1
    If Left$(numericText, 1) = "-" Then
        negative = True
        position = 2
    End If
    If position > Len(numericText) Then Exit Function

    For position = position To Len(numericText)
        characterValue = Mid$(numericText, position, 1)
        If characterValue >= "0" And characterValue <= "9" Then
            digitValue = AscW(characterValue) - AscW("0")
            digitFound = True
            If decimalFound Then
                divisor = divisor * 10#
                fractionPart = fractionPart + digitValue / divisor
            Else
                integerPart = integerPart * 10# + digitValue
            End If
        ElseIf characterValue = "." And Not decimalFound Then
            decimalFound = True
            divisor = 1#
        Else
            Exit Function
        End If
    Next position
    If Not digitFound Then Exit Function
    If decimalFound And Right$(numericText, 1) = "." Then Exit Function

    amount = integerPart + fractionPart
    If negative Then amount = -amount
    十進数を取得 = True
End Function

Private Function 半角へ正規化(ByVal sourceText As String) As String
    On Error GoTo KeepOriginal
    半角へ正規化 = StrConv(sourceText, vbNarrow)
    Exit Function
KeepOriginal:
    半角へ正規化 = sourceText
    Err.Clear
End Function

Private Function 日付と時刻を取得(ByVal dateValue As Variant, ByVal timeValue As Variant, _
                               ByRef dateTimeValue As Double) As Boolean
    Dim timeFraction As Double
    On Error GoTo InvalidDateTime
    If IsError(dateValue) Or IsEmpty(dateValue) Then Exit Function
    If Not IsDate(dateValue) Then Exit Function
    If Not 時刻を取得(timeValue, timeFraction) Then Exit Function
    dateTimeValue = Fix(CDbl(CDate(dateValue))) + timeFraction
    日付と時刻を取得 = True
    Exit Function
InvalidDateTime:
    日付と時刻を取得 = False
End Function

