Sub CSV取込()
    Dim ws As Worksheet, historyWS As Worksheet
    Set ws = ThisWorkbook.Sheets("記録")

    Dim filePath As String
    filePath = Application.GetOpenFilename("CSVファイル (*.csv), *.csv", , "CSVファイルを選択してください")
    If filePath = "False" Then Exit Sub

    Dim csvWB As Workbook
    Set csvWB = Workbooks.Open(filePath)
    Dim csvWS As Worksheet
    Set csvWS = csvWB.Sheets(1)

    Dim lastRowCSV As Long
    lastRowCSV = csvWS.Cells(csvWS.Rows.Count, 1).End(xlUp).Row
    If lastRowCSV < 3 Then
        MsgBox "CSVに有効なデータがありません。", vbExclamation
        csvWB.Close False
        Exit Sub
    End If

    On Error Resume Next
    Set historyWS = ThisWorkbook.Worksheets("取込履歴")
    On Error GoTo 0
    If historyWS Is Nothing Then
        MsgBox "「取込履歴」シートが見つかりません。CSV取込を中止します。", vbExclamation
        csvWB.Close False
        Exit Sub
    End If

    Dim historyIDs As Object
    Set historyIDs = CreateObject("Scripting.Dictionary")
    historyIDs.CompareMode = vbBinaryCompare
    If Not 取込履歴を準備(ws, historyWS, historyIDs) Then
        csvWB.Close False
        Exit Sub
    End If

    Dim i As Long, j As Long, targetRow As Long
    Dim id As Variant, idKey As String
    Dim insertedCount As Long, historyFailureCount As Long
    Dim firstInsertedRow As Long, lastInsertedRow As Long

    For i = 3 To lastRowCSV
        id = csvWS.Cells(i, 1).Value
        idKey = 回答番号をキー化(id)
        If Len(idKey) > 0 Then
            If Not historyIDs.Exists(idKey) Then
                targetRow = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row + 1
                If targetRow < 2 Then targetRow = 2
                For j = 1 To 15
                    ws.Cells(targetRow, j).Value = csvWS.Cells(i, j).Value
                Next j
                For j = 16 To 40
                    ws.Cells(targetRow, j + 1).Value = csvWS.Cells(i, j).Value
                Next j
                insertedCount = insertedCount + 1
                If firstInsertedRow = 0 Then firstInsertedRow = targetRow
                lastInsertedRow = targetRow
                If Not 取込履歴へ追加(historyWS, historyIDs, id, idKey) Then
                    historyFailureCount = historyFailureCount + 1
                End If
            End If
        End If
    Next i

    csvWB.Close False

    If insertedCount > 0 Then
        Dim headerRow As Long: headerRow = 1
        Dim lastRow As Long: lastRow = lastInsertedRow
        Dim keyPairs As Variant
        keyPairs = Array( _
            Array("行先", "行先（その他）"), _
            Array("用務", "用務（その他）"), _
            Array("ガソリン給油の有無 [給油の場合はその他に数値入力（?）]", "ガソリン給油量"), _
            Array("軽油給油の有無 [給油の場合はその他に数値入力（?）]", "軽油給油量"), _
            Array("オイル給油の有無 [給油の場合はその他に数値入力（?）]", "オイル給油量") _
        )
        Dim mainCol As Long, subCol As Long, k As Long
        For k = LBound(keyPairs) To UBound(keyPairs)
            mainCol = 0: subCol = 0
            For j = 1 To ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
                If ws.Cells(headerRow, j).Value = keyPairs(k)(0) Then mainCol = j
                If ws.Cells(headerRow, j).Value = keyPairs(k)(1) Then subCol = j
            Next j
            If mainCol = 0 Or subCol = 0 Then
                MsgBox "列が見つかりません：" & vbCrLf & _
                       "主項目: " & keyPairs(k)(0) & vbCrLf & _
                       "補足項目: " & keyPairs(k)(1), vbExclamation
            Else
                For i = firstInsertedRow To lastRow
                    If Trim(ws.Cells(i, mainCol).Value) = "その他" Then
                        ws.Cells(i, mainCol).Value = ws.Cells(i, subCol).Value
                        ws.Cells(i, subCol).ClearContents
                    End If
                Next i
            End If
        Next k

        Dim deleteOnlyPairs As Variant
        deleteOnlyPairs = Array( _
            Array("確認者（運転前） [「運行管理者」＝主管課長]", "確認者運転前（その他）"), _
            Array("確認者（運転後） [「運行管理者」＝主管課長]", "確認者運転後（その他）") _
        )
        For k = LBound(deleteOnlyPairs) To UBound(deleteOnlyPairs)
            mainCol = 0: subCol = 0
            For j = 1 To ws.Cells(headerRow, ws.Columns.Count).End(xlToLeft).Column
                If ws.Cells(headerRow, j).Value = deleteOnlyPairs(k)(0) Then mainCol = j
                If ws.Cells(headerRow, j).Value = deleteOnlyPairs(k)(1) Then subCol = j
            Next j
            If mainCol = 0 Or subCol = 0 Then
                MsgBox "列が見つかりません（削除対象）：" & vbCrLf & _
                       "主項目: " & deleteOnlyPairs(k)(0) & vbCrLf & _
                       "補足項目: " & deleteOnlyPairs(k)(1), vbExclamation
            Else
                For i = firstInsertedRow To lastRow
                    If Trim(ws.Cells(i, mainCol).Value) = "その他" Then
                        ws.Cells(i, mainCol).ClearContents
                    End If
                Next i
            End If
        Next k
    End If

    Call 入力内容チェック実行(False)
    If historyFailureCount > 0 Then
        MsgBox insertedCount & " 件のデータを追記しましたが、" & historyFailureCount & _
               " 件の回答番号を取込履歴へ登録できませんでした。履歴を確認してください。", vbExclamation
    Else
        MsgBox insertedCount & " 件のデータを追記し、「その他」の補完・削除処理を完了しました。", vbInformation
    End If
End Sub


Private Function 回答番号をキー化(ByVal answerId As Variant) As String
    On Error GoTo InvalidAnswerId
    If IsError(answerId) Or IsEmpty(answerId) Then Exit Function
    回答番号をキー化 = Trim$(CStr(answerId))
    Exit Function
InvalidAnswerId:
    回答番号をキー化 = ""
End Function

Private Function 取込履歴を準備(ByVal recordWS As Worksheet, ByVal historyWS As Worksheet, _
                              ByVal historyIDs As Object) As Boolean
    Dim headerValue As Variant, answerId As Variant, answerKey As String
    Dim lastHistoryRow As Long, lastRecordRow As Long, rowNo As Long
    On Error GoTo PrepareFailed
    headerValue = historyWS.Cells(1, 1).Value
    If IsError(headerValue) Then GoTo InvalidHeader
    If Len(Trim$(CStr(headerValue))) = 0 Then
        historyWS.Cells(1, 1).Value = "回答番号"
    ElseIf Trim$(CStr(headerValue)) <> "回答番号" Then
        GoTo InvalidHeader
    End If

    lastHistoryRow = historyWS.Cells(historyWS.Rows.Count, 1).End(xlUp).Row
    For rowNo = 2 To lastHistoryRow
        answerKey = 回答番号をキー化(historyWS.Cells(rowNo, 1).Value)
        If Len(answerKey) > 0 Then
            If Not historyIDs.Exists(answerKey) Then historyIDs.Add answerKey, True
        End If
    Next rowNo

    lastRecordRow = recordWS.Cells(recordWS.Rows.Count, 1).End(xlUp).Row
    For rowNo = 2 To lastRecordRow
        answerId = recordWS.Cells(rowNo, 1).Value
        answerKey = 回答番号をキー化(answerId)
        If Len(answerKey) > 0 Then
            If Not historyIDs.Exists(answerKey) Then
                If Not 取込履歴へ追加(historyWS, historyIDs, answerId, answerKey) Then GoTo PrepareFailed
            End If
        End If
    Next rowNo

    取込履歴を準備 = True
    Exit Function
InvalidHeader:
    MsgBox "「取込履歴」シートのA1を「回答番号」にしてください。データ保護のためCSV取込を中止しました。", vbExclamation
    Exit Function
PrepareFailed:
    MsgBox "取込履歴を同期できなかったため、CSV取込を中止しました。" & vbCrLf & Err.Description, vbExclamation
    Err.Clear
End Function


Private Function 取込履歴へ追加(ByVal historyWS As Worksheet, ByVal historyIDs As Object, _
                              ByVal answerId As Variant, ByVal answerKey As String) As Boolean
    Dim targetRow As Long
    On Error GoTo AddFailed
    If historyIDs.Exists(answerKey) Then
        取込履歴へ追加 = True
        Exit Function
    End If

    historyIDs.Add answerKey, True
    targetRow = historyWS.Cells(historyWS.Rows.Count, 1).End(xlUp).Row + 1
    If targetRow < 2 Then targetRow = 2
    historyWS.Cells(targetRow, 1).Value = answerId
    取込履歴へ追加 = True
    Exit Function
AddFailed:
    Err.Clear
End Function
Public Sub 入力内容チェック()
    Call 入力内容チェック実行(True)
End Sub

Private Function 入力内容チェック実行(ByVal 結果表示 As Boolean) As Long
    Dim ws As Worksheet, lastRow As Long, rowNo As Long
    Dim startMeter As Double, endMeter As Double, distanceKm As Double
    Dim startTime As Double, endTime As Double, durationMinutes As Long
    Dim startTimeValid As Boolean, endTimeValid As Boolean
    Dim warningText As String, commentFailures As Long

    Set ws = ThisWorkbook.Sheets("記録")
    lastRow = ws.Cells(ws.Rows.Count, "A").End(xlUp).Row
    If lastRow < 2 Then
        If 結果表示 Then MsgBox "確認対象の記録がありません。", vbInformation
        Exit Function
    End If

    Call 前回の自動チェック警告を除去(ws, 2, lastRow, commentFailures)
    For rowNo = 2 To lastRow
        If 数値入力あり(ws.Cells(rowNo, "P").Value) And 数値入力あり(ws.Cells(rowNo, "Q").Value) Then
            startMeter = CDbl(ws.Cells(rowNo, "P").Value)
            endMeter = CDbl(ws.Cells(rowNo, "Q").Value)
            distanceKm = endMeter - startMeter
            If distanceKm < 0 Then
                warningText = "要確認：終業時メーターが始業時メーターより小さくなっています。" & vbCrLf & _
                              "始業時メーター：" & Format$(startMeter, "0.##") & "km" & vbCrLf & _
                              "終業時メーター：" & Format$(endMeter, "0.##") & "km" & vbCrLf & "入力内容を確認してください。"
                Call 自動チェック警告を追加(ws.Cells(rowNo, "P"), warningText, commentFailures)
                Call 自動チェック警告を追加(ws.Cells(rowNo, "Q"), warningText, commentFailures)
            ElseIf distanceKm >= CHECK_LONG_DISTANCE_KM Then
                warningText = "要確認：1回の走行距離が" & Format$(CHECK_LONG_DISTANCE_KM, "0.##") & "km以上です。" & vbCrLf & _
                              "始業時メーター：" & Format$(startMeter, "0.##") & "km" & vbCrLf & _
                              "終業時メーター：" & Format$(endMeter, "0.##") & "km" & vbCrLf & _
                              "走行距離：" & Format$(distanceKm, "0.##") & "km" & vbCrLf & "入力内容を確認してください。"
                Call 自動チェック警告を追加(ws.Cells(rowNo, "P"), warningText, commentFailures)
                Call 自動チェック警告を追加(ws.Cells(rowNo, "Q"), warningText, commentFailures)
            End If
        End If

        startTimeValid = 時刻を取得(ws.Cells(rowNo, "N").Value, startTime)
        endTimeValid = 時刻を取得(ws.Cells(rowNo, "O").Value, endTime)
        If セルに値がある(ws.Cells(rowNo, "N").Value) And Not startTimeValid Then
            warningText = "要確認：使用開始時刻を時刻として認識できません。入力値：" & _
                          セル値を表示(ws.Cells(rowNo, "N").Value) & "。入力内容を確認してください。"
            Call 自動チェック警告を追加(ws.Cells(rowNo, "N"), warningText, commentFailures)
        End If
        If セルに値がある(ws.Cells(rowNo, "O").Value) And Not endTimeValid Then
            warningText = "要確認：使用終了時刻を時刻として認識できません。入力値：" & _
                          セル値を表示(ws.Cells(rowNo, "O").Value) & "。入力内容を確認してください。"
            Call 自動チェック警告を追加(ws.Cells(rowNo, "O"), warningText, commentFailures)
        End If

        If startTimeValid And endTimeValid Then
            If endTime < startTime Then
                warningText = "要確認：使用終了時刻が開始時刻より前になっています。" & vbCrLf & _
                              "開始：" & Format$(startTime, "hh:mm") & vbCrLf & _
                              "終了：" & Format$(endTime, "hh:mm") & vbCrLf & "入力内容を確認してください。"
                Call 自動チェック警告を追加(ws.Cells(rowNo, "N"), warningText, commentFailures)
                Call 自動チェック警告を追加(ws.Cells(rowNo, "O"), warningText, commentFailures)
            Else
                durationMinutes = CLng((endTime - startTime) * 1440# + 0.5)
                If (endTime - startTime) * 24# >= CHECK_LONG_USAGE_HOURS Then
                    warningText = "要確認：使用時間が" & Format$(CHECK_LONG_USAGE_HOURS, "0.##") & "時間以上です。" & vbCrLf & _
                                  "開始：" & Format$(startTime, "hh:mm") & vbCrLf & "終了：" & Format$(endTime, "hh:mm") & vbCrLf & _
                                  "使用時間：" & 使用時間を表示(durationMinutes) & vbCrLf & "入力内容を確認してください。"
                    Call 自動チェック警告を追加(ws.Cells(rowNo, "N"), warningText, commentFailures)
                    Call 自動チェック警告を追加(ws.Cells(rowNo, "O"), warningText, commentFailures)
                End If
            End If
        End If
    Next rowNo

    Call 車両選択候補をチェック(ws, lastRow, commentFailures)
    入力内容チェック実行 = commentFailures
    If commentFailures > 0 Then
        MsgBox "入力チェックは完了しましたが、" & commentFailures & _
               "セルの警告コメントまたは既存コメントを処理できませんでした。該当セルを確認してください。", vbExclamation
    ElseIf 結果表示 Then
        MsgBox "入力内容チェックが完了しました。要確認の記録には赤字・太字とコメントを付けています。", vbInformation
    End If
End Function

Private Function 数値入力あり(ByVal cellValue As Variant) As Boolean
    If IsError(cellValue) Or IsEmpty(cellValue) Then Exit Function
    If Len(Trim$(CStr(cellValue))) = 0 Then Exit Function
    数値入力あり = IsNumeric(cellValue)
End Function

Private Function セルに値がある(ByVal cellValue As Variant) As Boolean
    If IsError(cellValue) Then
        セルに値がある = True
    ElseIf IsEmpty(cellValue) Then
        セルに値がある = False
    Else
        セルに値がある = (Len(Trim$(CStr(cellValue))) > 0)
    End If
End Function

Private Function セル値を表示(ByVal cellValue As Variant) As String
    If IsError(cellValue) Then
        セル値を表示 = "Excelエラー値"
    ElseIf IsEmpty(cellValue) Then
        セル値を表示 = "（空欄）"
    Else
        セル値を表示 = CStr(cellValue)
    End If
End Function

Private Function 時刻を取得(ByVal cellValue As Variant, ByRef timeFraction As Double) As Boolean
    Dim numericValue As Double
    On Error GoTo InvalidTime
    If IsError(cellValue) Or IsEmpty(cellValue) Then Exit Function

    If VarType(cellValue) = vbDate Then
        timeFraction = CDbl(TimeValue(CDate(cellValue)))
        時刻を取得 = True
        Exit Function
    End If

    If VarType(cellValue) <> vbString And IsNumeric(cellValue) Then
        numericValue = CDbl(cellValue)
        If numericValue < 0# Or numericValue >= 2958466# Then Exit Function
        timeFraction = numericValue - Fix(numericValue)
        時刻を取得 = True
        Exit Function
    End If

    If Len(Trim$(CStr(cellValue))) = 0 Then Exit Function
    If Not IsDate(cellValue) Then Exit Function
    timeFraction = CDbl(TimeValue(CDate(cellValue)))
    時刻を取得 = True
    Exit Function
InvalidTime:
    時刻を取得 = False
End Function

Private Function 使用時間を表示(ByVal totalMinutes As Long) As String
    使用時間を表示 = CStr(totalMinutes \ 60) & "時間" & CStr(totalMinutes Mod 60) & "分"
End Function

Private Function 日付と時刻を取得(ByVal dateValue As Variant, ByVal timeValue As Variant, _
                               ByRef dateTimeValue As Double) As Boolean
    Dim timeFraction As Double
    On Error GoTo InvalidDateTime
    If IsError(dateValue) Or IsEmpty(dateValue) Then Exit Function
    If Not IsDate(dateValue) Then Exit Function
    If Not 時刻を取得(timeValue, timeFraction) Then Exit Function
    dateTimeValue = Fix(CDbl(CDate(dateValue))) + timeFraction
    日付と時刻を取得 = True
    Exit Function
InvalidDateTime:
    日付と時刻を取得 = False
End Function

Private Sub 前回の自動チェック警告を除去(ByVal ws As Worksheet, ByVal firstRow As Long, _
                                      ByVal lastRow As Long, ByRef errorCount As Long)
    Dim rowNo As Long, columnName As Variant
    For Each columnName In Array("J", "N", "O", "P", "Q")
        For rowNo = firstRow To lastRow
            Call セルの自動チェック警告を除去(ws.Cells(rowNo, CStr(columnName)), errorCount)
        Next rowNo
    Next columnName
End Sub

Private Sub セルの自動チェック警告を除去(ByVal target As Range, ByRef errorCount As Long)
    Dim note As Comment
    Dim existingText As String, prefixText As String, suffixText As String, newText As String
    Dim markerStart As Long, headerEnd As Long, markerEnd As Long, metadataStart As Long
    Dim metadataText As String, metadataParts As Variant
    Dim originalColor As Long, originalBold As Boolean

    On Error GoTo RemoveFailed
    Set note = target.Comment
    If note Is Nothing Then Exit Sub
    existingText = note.Text
    markerStart = InStr(1, existingText, CHECK_WARNING_START, vbBinaryCompare)
    If markerStart = 0 Then Exit Sub
    headerEnd = InStr(markerStart, existingText, "】", vbBinaryCompare)
    If headerEnd = 0 Then Exit Sub
    markerEnd = InStr(headerEnd + 1, existingText, CHECK_WARNING_END, vbBinaryCompare)
    If markerEnd = 0 Then Exit Sub

    metadataStart = markerStart + Len(CHECK_WARNING_START)
    metadataText = Mid$(existingText, metadataStart, headerEnd - metadataStart)
    metadataParts = Split(metadataText, "|")
    If UBound(metadataParts) <> 1 Then Exit Sub
    If Not IsNumeric(metadataParts(0)) Or Not IsNumeric(metadataParts(1)) Then Exit Sub
    originalColor = CLng(metadataParts(0))
    originalBold = (CLng(metadataParts(1)) <> 0)

    prefixText = Left$(existingText, markerStart - 1)
    If Right$(prefixText, Len(vbCrLf)) = vbCrLf Then
        prefixText = Left$(prefixText, Len(prefixText) - Len(vbCrLf))
    End If
    suffixText = Mid$(existingText, markerEnd + Len(CHECK_WARNING_END))
    newText = prefixText & suffixText
    If target.Font.Color = vbRed And target.Font.Bold = True Then
        target.Font.Color = originalColor
        target.Font.Bold = originalBold
    End If
    If Len(Trim$(newText)) = 0 Then
        note.Delete
    Else
        note.Text Text:=newText
    End If
    Exit Sub
RemoveFailed:
    errorCount = errorCount + 1
    Err.Clear
End Sub

Private Sub 自動チェック警告を追加(ByVal target As Range, ByVal warningText As String, _
                                ByRef errorCount As Long)
    Dim note As Comment
    Dim existingText As String, newText As String, markerText As String, managedText As String
    Dim markerStart As Long, headerEnd As Long, markerEnd As Long, metadataStart As Long, bodyStart As Long
    Dim metadataText As String, metadataParts As Variant, existingWarnings As String
    Dim originalColor As Long, originalBold As Boolean, createdComment As Boolean

    On Error GoTo AddFailed
    Set note = target.Comment
    If note Is Nothing Then
        target.AddComment
        Set note = target.Comment
        createdComment = True
        existingText = ""
    Else
        existingText = note.Text
    End If

    markerStart = InStr(1, existingText, CHECK_WARNING_START, vbBinaryCompare)
    If markerStart > 0 Then
        headerEnd = InStr(markerStart, existingText, "】", vbBinaryCompare)
        If headerEnd > 0 Then
            markerEnd = InStr(headerEnd + 1, existingText, CHECK_WARNING_END, vbBinaryCompare)
            If markerEnd > 0 Then
                metadataStart = markerStart + Len(CHECK_WARNING_START)
                metadataText = Mid$(existingText, metadataStart, headerEnd - metadataStart)
                metadataParts = Split(metadataText, "|")
                If UBound(metadataParts) = 1 Then
                    If IsNumeric(metadataParts(0)) And IsNumeric(metadataParts(1)) Then
                        bodyStart = headerEnd + Len("】") + Len(vbCrLf)
                        existingWarnings = Mid$(existingText, bodyStart, markerEnd - bodyStart)
                        If InStr(1, existingWarnings, warningText, vbBinaryCompare) = 0 Then
                            markerText = Mid$(existingText, markerStart, headerEnd - markerStart + Len("】"))
                            managedText = markerText & vbCrLf & existingWarnings & vbCrLf & warningText & _
                                          vbCrLf & CHECK_WARNING_END
                            newText = Left$(existingText, markerStart - 1) & managedText & _
                                      Mid$(existingText, markerEnd + Len(CHECK_WARNING_END))
                            note.Text Text:=newText
                        End If
                        target.Font.Color = vbRed
                        target.Font.Bold = True
                        Exit Sub
                    End If
                End If
            End If
        End If
    End If

    originalColor = CLng(target.Font.Color)
    originalBold = CBool(target.Font.Bold)
    markerText = CHECK_WARNING_START & CStr(originalColor) & "|" & _
                 CStr(Abs(CLng(originalBold))) & "】"
    managedText = markerText & vbCrLf & warningText & vbCrLf & CHECK_WARNING_END
    If Len(existingText) > 0 Then
        newText = existingText & vbCrLf & managedText
    Else
        newText = managedText
    End If
    note.Text Text:=newText
    target.Font.Color = vbRed
    target.Font.Bold = True
    Exit Sub
AddFailed:
    If createdComment Then
        On Error Resume Next
        note.Delete
        On Error GoTo 0
    End If
    errorCount = errorCount + 1
    Err.Clear
End Sub

Private Sub 車両選択候補をチェック(ByVal ws As Worksheet, ByVal lastRow As Long, _
                                 ByRef errorCount As Long)
    Dim vehicleNames() As String, rowVehicleIndex() As Long
    Dim rowStartDateTime() As Double, rowEndDateTime() As Double, rowTimesValid() As Boolean
    Dim rowEndMeterValid() As Boolean, rowEndMeter() As Double
    Dim previousFound() As Boolean, nextFound() As Boolean, vehicleOverlaps() As Boolean
    Dim previousDateTime() As Double, nextDateTime() As Double
    Dim previousMeterValid() As Boolean, nextMeterValid() As Boolean
    Dim previousMeter() As Double, nextMeter() As Double
    Dim vehicleCount As Long, rowNo As Long, otherRow As Long, vehicleIndex As Long, assignedIndex As Long
    Dim currentVehicle As String, vehicleValue As Variant, currentStart As Double, currentEnd As Double
    Dim assignedMismatch As Boolean, candidateCount As Long, candidateIndex As Long, warningText As String

    If lastRow < 3 Then Exit Sub
    ReDim vehicleNames(1 To lastRow - 1)
    ReDim rowVehicleIndex(1 To lastRow)
    ReDim rowStartDateTime(1 To lastRow)
    ReDim rowEndDateTime(1 To lastRow)
    ReDim rowTimesValid(1 To lastRow)
    ReDim rowEndMeterValid(1 To lastRow)
    ReDim rowEndMeter(1 To lastRow)

    For rowNo = 2 To lastRow
        vehicleValue = ws.Cells(rowNo, "J").Value
        If Not IsError(vehicleValue) And Not IsEmpty(vehicleValue) Then
            currentVehicle = Trim$(CStr(vehicleValue))
            If Len(currentVehicle) > 0 Then
                For vehicleIndex = 1 To vehicleCount
                    If StrComp(vehicleNames(vehicleIndex), currentVehicle, vbTextCompare) = 0 Then Exit For
                Next vehicleIndex
                If vehicleIndex > vehicleCount Then
                    vehicleCount = vehicleCount + 1
                    vehicleNames(vehicleCount) = currentVehicle
                    vehicleIndex = vehicleCount
                End If
                rowVehicleIndex(rowNo) = vehicleIndex
            End If
        End If

        rowTimesValid(rowNo) = 日付と時刻を取得(ws.Cells(rowNo, "K").Value, _
                                             ws.Cells(rowNo, "N").Value, rowStartDateTime(rowNo)) And _
                               日付と時刻を取得(ws.Cells(rowNo, "K").Value, _
                                             ws.Cells(rowNo, "O").Value, rowEndDateTime(rowNo))
        If rowTimesValid(rowNo) Then
            If rowEndDateTime(rowNo) < rowStartDateTime(rowNo) Then rowTimesValid(rowNo) = False
        End If
        rowEndMeterValid(rowNo) = 数値入力あり(ws.Cells(rowNo, "Q").Value)
        If rowEndMeterValid(rowNo) Then rowEndMeter(rowNo) = CDbl(ws.Cells(rowNo, "Q").Value)
    Next rowNo
    If vehicleCount < 2 Then Exit Sub

    For rowNo = 2 To lastRow
        assignedIndex = rowVehicleIndex(rowNo)
        If assignedIndex = 0 Or Not rowTimesValid(rowNo) Or Not rowEndMeterValid(rowNo) Then GoTo NextVehicleRecord
        currentStart = rowStartDateTime(rowNo)
        currentEnd = rowEndDateTime(rowNo)
        ReDim previousFound(1 To vehicleCount)
        ReDim nextFound(1 To vehicleCount)
        ReDim vehicleOverlaps(1 To vehicleCount)
        ReDim previousDateTime(1 To vehicleCount)
        ReDim nextDateTime(1 To vehicleCount)
        ReDim previousMeterValid(1 To vehicleCount)
        ReDim nextMeterValid(1 To vehicleCount)
        ReDim previousMeter(1 To vehicleCount)
        ReDim nextMeter(1 To vehicleCount)

        For otherRow = 2 To lastRow
            vehicleIndex = rowVehicleIndex(otherRow)
            If otherRow <> rowNo And vehicleIndex > 0 And rowTimesValid(otherRow) Then
                If rowStartDateTime(otherRow) < currentEnd And rowEndDateTime(otherRow) > currentStart Then
                    vehicleOverlaps(vehicleIndex) = True
                End If
                If rowEndDateTime(otherRow) <= currentStart Then
                    If Not previousFound(vehicleIndex) Or rowEndDateTime(otherRow) > previousDateTime(vehicleIndex) Then
                        previousFound(vehicleIndex) = True
                        previousDateTime(vehicleIndex) = rowEndDateTime(otherRow)
                        previousMeterValid(vehicleIndex) = rowEndMeterValid(otherRow)
                        If rowEndMeterValid(otherRow) Then previousMeter(vehicleIndex) = rowEndMeter(otherRow)
                    End If
                End If
                If rowStartDateTime(otherRow) >= currentEnd Then
                    If Not nextFound(vehicleIndex) Or rowStartDateTime(otherRow) < nextDateTime(vehicleIndex) Then
                        nextFound(vehicleIndex) = True
                        nextDateTime(vehicleIndex) = rowStartDateTime(otherRow)
                        nextMeterValid(vehicleIndex) = rowEndMeterValid(otherRow)
                        If rowEndMeterValid(otherRow) Then nextMeter(vehicleIndex) = rowEndMeter(otherRow)
                    End If
                End If
            End If
        Next otherRow

        assignedMismatch = previousFound(assignedIndex) And nextFound(assignedIndex) And _
                           previousMeterValid(assignedIndex) And nextMeterValid(assignedIndex)
        If assignedMismatch Then
            assignedMismatch = rowEndMeter(rowNo) < previousMeter(assignedIndex) - CHECK_VEHICLE_SELECTION_ODO_TOLERANCE_KM Or _
                               rowEndMeter(rowNo) > nextMeter(assignedIndex) + CHECK_VEHICLE_SELECTION_ODO_TOLERANCE_KM
        End If
        If Not assignedMismatch Then GoTo NextVehicleRecord

        candidateCount = 0
        candidateIndex = 0
        For vehicleIndex = 1 To vehicleCount
            If vehicleIndex <> assignedIndex And Not vehicleOverlaps(vehicleIndex) And _
               previousFound(vehicleIndex) And nextFound(vehicleIndex) And _
               previousMeterValid(vehicleIndex) And nextMeterValid(vehicleIndex) Then
                If previousMeter(vehicleIndex) <= rowEndMeter(rowNo) + CHECK_VEHICLE_SELECTION_ODO_TOLERANCE_KM And _
                   rowEndMeter(rowNo) <= nextMeter(vehicleIndex) + CHECK_VEHICLE_SELECTION_ODO_TOLERANCE_KM Then
                    candidateCount = candidateCount + 1
                    candidateIndex = vehicleIndex
                End If
            End If
        Next vehicleIndex

        If candidateCount = 1 Then
            warningText = "要確認：車両選択間違いの可能性があります。" & vbCrLf & vbCrLf & _
                          "回答番号：" & セル値を表示(ws.Cells(rowNo, "A").Value) & vbCrLf & _
                          "運転日：" & Format$(Fix(rowStartDateTime(rowNo)), "yyyy/m/d") & vbCrLf & _
                          "使用時間：" & Format$(rowStartDateTime(rowNo), "hh:mm") & "～" & Format$(rowEndDateTime(rowNo), "hh:mm") & vbCrLf & _
                          "運転者：" & セル値を表示(ws.Cells(rowNo, "W").Value) & vbCrLf
            If セルに値がある(ws.Cells(rowNo, "R").Value) Then warningText = warningText & "行先：" & セル値を表示(ws.Cells(rowNo, "R").Value) & vbCrLf
            If セルに値がある(ws.Cells(rowNo, "T").Value) Then warningText = warningText & "用務：" & セル値を表示(ws.Cells(rowNo, "T").Value) & vbCrLf
            warningText = warningText & vbCrLf & _
                          "登録車両：" & vehicleNames(assignedIndex) & vbCrLf & _
                          "候補車両：" & vehicleNames(candidateIndex) & vbCrLf & vbCrLf & _
                          "【登録車両 " & vehicleNames(assignedIndex) & " のメーター推移】" & vbCrLf & _
                          Format$(previousMeter(assignedIndex), "0.##") & " → " & Format$(rowEndMeter(rowNo), "0.##") & " → " & Format$(nextMeter(assignedIndex), "0.##") & vbCrLf & vbCrLf & _
                          "【候補車両 " & vehicleNames(candidateIndex) & " のメーター推移】" & vbCrLf & _
                          Format$(previousMeter(candidateIndex), "0.##") & " → " & Format$(rowEndMeter(rowNo), "0.##") & " → " & Format$(nextMeter(candidateIndex), "0.##") & vbCrLf & vbCrLf & _
                          vehicleNames(candidateIndex) & "号車として扱う方がメーター推移と時間関係が自然です。" & vbCrLf & _
                          "実際に使用した車両を確認してください。"
            Call 自動チェック警告を追加(ws.Cells(rowNo, "J"), warningText, errorCount)
        End If
NextVehicleRecord:
    Next rowNo
End Sub

Private Sub 車両選択候補の事前チェック(ByVal ws As Worksheet, ByVal lastRow As Long)
    Dim rowNo As Long, commentFailures As Long
    For rowNo = 2 To lastRow
        Call セルの自動チェック警告を除去(ws.Cells(rowNo, "J"), commentFailures)
    Next rowNo
    Call 車両選択候補をチェック(ws, lastRow, commentFailures)
    If commentFailures > 0 Then
        MsgBox "車両選択候補の事前チェックで、" & commentFailures & _
               "セルの警告コメントまたは既存コメントを処理できませんでした。該当セルを確認してください。", vbExclamation
    End If
End Sub

Sub 記録シート整理()
    Dim ws As Worksheet
    Set ws = ThisWorkbook.Sheets("記録")

    Dim lastRow As Long
    lastRow = ws.Cells(ws.Rows.Count, "A").End(xlUp).Row
    If lastRow < 3 Then
        MsgBox "データが不足しています。", vbExclamation
        Exit Sub
    End If

    ' P列を誤った登録車両の前回Qで補完する前に、Q列と日時だけで候補を確認する。
    Call 車両選択候補の事前チェック(ws, lastRow)

    ' 並び替え（2行目から）
    With ws.Sort
        .SortFields.Clear
        .SortFields.Add Key:=ws.Range("J2:J" & lastRow), Order:=xlAscending
        .SortFields.Add Key:=ws.Range("K2:K" & lastRow), Order:=xlAscending
        .SortFields.Add Key:=ws.Range("N2:N" & lastRow), Order:=xlAscending
        .SetRange ws.Range("A2:AO" & lastRow)
        .Header = xlNo ' ヘッダーなしで並び替える
        .Apply
    End With

    ' 自動補完処理（P列：始業時メーター）
    Dim i As Long
    Dim current車両 As String, previous車両 As String
    Dim previousメーター As Variant

    previous車両 = ""
    previousメーター = ""

    For i = 2 To lastRow
        current車両 = ws.Cells(i, "J").Value

        If current車両 = previous車両 And IsNumeric(previousメーター) Then
            ws.Cells(i, "P").Value = previousメーター
        End If

        previous車両 = current車両
        previousメーター = ws.Cells(i, "Q").Value
    Next i

    Call 入力内容チェック実行(False)

    MsgBox "並び替えと始業時メーターの補完が完了しました。", vbInformation
End Sub
Sub 転記to印刷様式()
    Dim wsSrc As Worksheet, wsDest As Worksheet
    Set wsSrc = ThisWorkbook.Sheets("記録")
    Set wsDest = ThisWorkbook.Sheets("印刷様式")

    Dim carNo As String
    Dim ansStart As Long, ansEnd As Long
    Dim i As Long, destTopRow As Long
    Dim rowCount As Integer: rowCount = 0

    carNo = wsDest.Range("N2").Value
    ansStart = wsDest.Range("O2").Value
    ansEnd = wsDest.Range("P2").Value

    If carNo = "" Or ansStart = 0 Or ansEnd = 0 Then
        MsgBox "N2～P2に車両番号・開始回答番号・終了回答番号を入力してください。", vbExclamation
        Exit Sub
    End If

    For i = 2 To wsSrc.Cells(wsSrc.Rows.Count, "A").End(xlUp).Row
        If wsSrc.Cells(i, "J").Value = carNo Then
            If wsSrc.Cells(i, "A").Value >= ansStart And wsSrc.Cells(i, "A").Value <= ansEnd Then
                destTopRow = 3 + rowCount * 22 ' 21行使用＋1行空き

                With wsDest
                    .Range("A" & destTopRow).Value = wsSrc.Cells(i, "K").Value ' 運転した日
                    .Range("D" & destTopRow).Value = wsSrc.Cells(i, "L").Value ' 天気
                    .Range("G" & destTopRow).Value = wsSrc.Cells(i, "M").Value ' 自動車の状況
                    .Range("J" & destTopRow).Value = wsSrc.Cells(i, "J").Value ' 車両番号

                    .Range("B" & (destTopRow + 2)).Value = wsSrc.Cells(i, "N").Value ' 使用時間（始）
                    .Range("B" & (destTopRow + 3)).Value = wsSrc.Cells(i, "O").Value ' 使用時間（終）

                    .Range("D" & (destTopRow + 2)).Value = wsSrc.Cells(i, "R").Value ' 行先
                    .Range("D" & (destTopRow + 3)).Value = wsSrc.Cells(i, "P").Value ' 始業メーター
                    .Range("D" & (destTopRow + 4)).Value = wsSrc.Cells(i, "Q").Value ' 終業メーター

                    .Range("E" & (destTopRow + 2)).Value = wsSrc.Cells(i, "T").Value ' 用務
                    .Range("G" & (destTopRow + 3)).Value = wsSrc.Cells(i, "V").Value ' 乗車人数
                    .Range("H" & (destTopRow + 3)).Value = wsSrc.Cells(i, "W").Value ' 運転者氏名

                    .Range("K" & (destTopRow + 2)).Value = wsSrc.Cells(i, "X").Value ' ガソリン給油
                    .Range("K" & (destTopRow + 3)).Value = wsSrc.Cells(i, "Z").Value ' 軽油給油
                    .Range("K" & (destTopRow + 4)).Value = wsSrc.Cells(i, "AB").Value ' オイル給油

                    ' --- 燃料残量（L列） ---
                    Dim fuelLevel As Long
                    fuelLevel = val(Trim(wsSrc.Cells(i, "AD").Value))
                    If fuelLevel >= 2 And fuelLevel <= 5 Then
                        .Range("L" & (destTopRow + 3)).Value = String(fuelLevel - 1, "■")
                    Else
                        .Range("L" & (destTopRow + 3)).Value = ""
                    End If

                    ' --- 酒気帯びチェック（運転前） ---
                    Call 転記_確認者チェック(wsSrc, wsDest, i, destTopRow + 6, "AE", "AF", "AG", "AH", "AI")

                    ' --- 酒気帯びチェック（運転後） ---
                    Call 転記_確認者チェック(wsSrc, wsDest, i, destTopRow + 12, "AJ", "AK", "AL", "AM", "AN")

                    ' --- 特記事項 ---
                    .Range("B" & (destTopRow + 18)).Value = wsSrc.Cells(i, "AO").Value
                End With

                rowCount = rowCount + 1
                ' ← 行数制限は削除！
            End If
        End If
    Next i

    MsgBox rowCount & " 件のデータを印刷様式に転記しました。", vbInformation
End Sub

Sub 転記_確認者チェック(wsSrc As Worksheet, wsDest As Worksheet, rowSrc As Long, baseRow As Long, _
                          col確認者 As String, colその他 As String, col方法 As String, col有無 As String, col数値 As String)

    Dim val確認者 As String: val確認者 = wsSrc.Cells(rowSrc, col確認者).Value
    Dim val方法 As String: val方法 = wsSrc.Cells(rowSrc, col方法).Value
    Dim val有無 As String: val有無 = wsSrc.Cells(rowSrc, col有無).Value

    ' --- 確認者チェック（E列） ---
    wsDest.Cells(baseRow, "E").Value = IIf(val確認者 = "運転者本人", "■", "□")
    wsDest.Cells(baseRow + 1, "E").Value = IIf(val確認者 = "副運行管理者", "■", "□")
    wsDest.Cells(baseRow + 2, "E").Value = IIf(val確認者 = "運行管理者", "■", "□")
    
    ' ここがポイント！
    If val確認者 = "その他" Or val確認者 = "" Then
        wsDest.Cells(baseRow + 3, "E").Value = "■"
        wsDest.Cells(baseRow + 4, "F").Value = wsSrc.Cells(rowSrc, colその他).Value
    Else
        wsDest.Cells(baseRow + 3, "E").Value = "□"
        wsDest.Cells(baseRow + 4, "F").MergeArea.ClearContents
    End If


    ' --- F列への処理（その他 or 確認者が空白なら備考等を出力） ---
    If val確認者 = "その他" Or val確認者 = "" Then
        wsDest.Cells(baseRow + 4, "F").Value = wsSrc.Cells(rowSrc, colその他).Value
    Else
        wsDest.Cells(baseRow + 4, "F").MergeArea.ClearContents
    End If

    ' --- 確認方法（H列） ---
    wsDest.Cells(baseRow, "H").Value = IIf(val方法 = "対面", "■", "□")
    wsDest.Cells(baseRow + 1, "H").Value = IIf(val方法 <> "対面", "■", "□")

    ' --- 酒気帯びの有無（J列） ---
    wsDest.Cells(baseRow, "J").Value = IIf(val有無 = "有", "■", "□")
    wsDest.Cells(baseRow + 1, "J").Value = IIf(val有無 = "無", "■", "□")

    ' --- アルコール検知器の数値（K列） ---
    wsDest.Cells(baseRow + 4, "K").Value = wsSrc.Cells(rowSrc, col数値).Value

End Sub
Sub 一括消去()

    Dim ws As Worksheet
    Set ws = ThisWorkbook.Sheets("印刷様式")

    Dim i As Integer
    Dim blockStartRow As Long
    Dim blockHeight As Long: blockHeight = 22 ' 1ブロック21行＋1行空け
    Dim maxRow As Long
    Dim maxBlocks As Integer

    maxRow = ws.UsedRange.Rows(ws.UsedRange.Rows.Count).Row
    maxBlocks = Int((maxRow - 3) / blockHeight) + 1

    Dim r As Range

    For i = 0 To maxBlocks - 1
        blockStartRow = 3 + i * blockHeight

        With ws
            ' --- ヘッダー部 ---
            For Each r In .Range("A" & blockStartRow & ":A" & blockStartRow)
                r.MergeArea.ClearContents
            Next r
            For Each r In .Range("D" & blockStartRow & ":D" & blockStartRow)
                r.MergeArea.ClearContents
            Next r
            For Each r In .Range("G" & blockStartRow & ":G" & blockStartRow)
                r.MergeArea.ClearContents
            Next r
            For Each r In .Range("J" & blockStartRow & ":J" & blockStartRow)
                r.MergeArea.ClearContents
            Next r

            ' --- 基本情報 ---
            For Each r In .Range("B" & (blockStartRow + 2) & ":B" & (blockStartRow + 3))
                r.MergeArea.ClearContents
            Next r
            For Each r In .Range("D" & (blockStartRow + 2) & ":D" & (blockStartRow + 4))
                r.MergeArea.ClearContents
            Next r
            For Each r In .Range("E" & (blockStartRow + 2) & ":E" & (blockStartRow + 2))
                r.MergeArea.ClearContents
            Next r
            For Each r In .Range("G" & (blockStartRow + 3) & ":G" & (blockStartRow + 3))
                r.MergeArea.ClearContents
            Next r
            For Each r In .Range("H" & (blockStartRow + 3) & ":H" & (blockStartRow + 3))
                r.MergeArea.ClearContents
            Next r

            ' --- 給油情報 ---
            For Each r In .Range("K" & (blockStartRow + 2) & ":K" & (blockStartRow + 4))
                r.MergeArea.ClearContents
            Next r

            ' --- 燃料残量 ---
            For Each r In .Range("L" & (blockStartRow + 3) & ":L" & (blockStartRow + 3))
                r.MergeArea.ClearContents
            Next r

            ' --- 酒気帯び確認（運転前） ---
            For Each r In .Range("E" & (blockStartRow + 6) & ":E" & (blockStartRow + 9))
                r.MergeArea.ClearContents
            Next r
            For Each r In .Range("F" & (blockStartRow + 10) & ":F" & (blockStartRow + 10))
                r.MergeArea.ClearContents
            Next r
            For Each r In .Range("H" & (blockStartRow + 6) & ":H" & (blockStartRow + 7))
                r.MergeArea.ClearContents
            Next r
            For Each r In .Range("J" & (blockStartRow + 6) & ":J" & (blockStartRow + 7))
                r.MergeArea.ClearContents
            Next r
            For Each r In .Range("J" & (blockStartRow + 8) & ":J" & (blockStartRow + 8))
                r.MergeArea.ClearContents
            Next r
            For Each r In .Range("K" & (blockStartRow + 10) & ":K" & (blockStartRow + 10))
                r.MergeArea.ClearContents
            Next r

            ' --- 酒気帯び確認（運転後） ---
            For Each r In .Range("E" & (blockStartRow + 12) & ":E" & (blockStartRow + 15))
                r.MergeArea.ClearContents
            Next r
            For Each r In .Range("F" & (blockStartRow + 16) & ":F" & (blockStartRow + 16))
                r.MergeArea.ClearContents
            Next r
            For Each r In .Range("H" & (blockStartRow + 12) & ":H" & (blockStartRow + 13))
                r.MergeArea.ClearContents
            Next r
            For Each r In .Range("J" & (blockStartRow + 12) & ":J" & (blockStartRow + 13))
                r.MergeArea.ClearContents
            Next r
            For Each r In .Range("J" & (blockStartRow + 14) & ":J" & (blockStartRow + 14))
                r.MergeArea.ClearContents
            Next r
            For Each r In .Range("K" & (blockStartRow + 16) & ":K" & (blockStartRow + 16))
                r.MergeArea.ClearContents
            Next r

            ' --- 特記事項 ---
            For Each r In .Range("B" & (blockStartRow + 18) & ":B" & (blockStartRow + 18))
                r.MergeArea.ClearContents
            Next r
        End With
    Next i

    MsgBox "印刷様式の転記内容を初期化しました。", vbInformation

End Sub

