Private Sub 最新の車両候補を再判定()
    Dim ws As Worksheet, lastRow As Long, ignoredErrors As Long
    Set ws = ThisWorkbook.Sheets("記録")
    lastRow = 記録最終行(ws)
    Set vehicleReviewCandidates = New Collection
    If lastRow >= 3 Then Call 車両選択候補をチェック(ws, lastRow, ignoredErrors, False)
